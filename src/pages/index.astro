---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AtAGlance from '../components/AtAGlance.astro';
import IntroWindows from '../components/IntroWindows.astro';
import WorkSection from '../components/WorkSection.astro';
import BuildsSection from '../components/BuildsSection.astro';
import MoreAboutSection from '../components/MoreAboutSection.astro';
import Shelf from '../components/Shelf.astro';
import SignOff from '../components/SignOff.astro';
---

<Layout>
  <main id="main-content" class="page">
    <Hero />
    <AtAGlance />
    <IntroWindows />
    <WorkSection />
    <BuildsSection />
    <MoreAboutSection />
    <Shelf />
    <SignOff />
  </main>
</Layout>
