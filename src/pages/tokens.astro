---
import Layout from '../layouts/Layout.astro';
import DocHeader from '../components/DocHeader.astro';
import WindowChrome from '../components/WindowChrome.astro';
import tokensCss from '../styles/tokens.css?raw';

// Read straight from tokens.css at build time, so the list can't drift out of sync.
const declarations = [...tokensCss.matchAll(/--([a-z0-9-]+):\s*([^;]+);/g)].map((m) => ({
  name: m[1],
  value: m[2].trim(),
}));
const seen = new Set<string>();
const unique = declarations.filter((d) => !seen.has(d.name) && seen.add(d.name));
const colorTokens = unique.filter((d) => /^#[0-9a-f]{3,8}$/i.test(d.value));
const fontTokens = unique.filter((d) => d.name.startsWith('font-'));
---

<Layout title="Token Reference — Nirmal">
  <main id="main-content" class="page doc">
    <DocHeader title="Token Reference">
      <p class="doc-lead">
        Every colour and font token in <code class="tok-code">tokens.css</code>.
      </p>
    </DocHeader>

    <WindowChrome title="tokens.css" as="article" class="doc-window">
      <div class="prose">
        <section aria-labelledby="tok-preview">
          <h2 id="tok-preview">Live preview</h2>
          <p class="tok-note">Built from <code>var(--token)</code>, not hardcoded values.</p>
          <div class="tok-demo">
            <div class="tok-row">
              <button type="button" class="mbtn go">Primary button</button>
              <button type="button" class="mbtn">Outline button</button>
              <a href="#" onclick="return false;">A text link</a>
              <span class="chip">Badge</span>
            </div>
            <div class="tok-row tok-text">
              <p class="tok-ink">Body text in <code>--ink</code>.</p>
              <p class="tok-ink-2">Secondary text in <code>--ink-2</code>.</p>
              <p class="tok-muted">Dim/meta text in <code>--muted</code>.</p>
            </div>
            <div class="tok-row">
              <code class="tok-block">const blue = "var(--blue)";</code>
            </div>
            <div class="tok-row">
              <div class="tok-card">
                <span class="t-label tok-card-label">--panel card on --paper surface</span>
                <div class="tok-card-inner">--ink outline</div>
              </div>
            </div>
          </div>
        </section>

        <section aria-labelledby="tok-colours">
          <h2 id="tok-colours">Colours</h2>
          <ul class="ruled tok-list">
            {colorTokens.map((row) => (
              <li class="tok-token">
                <span class="tok-swatch" style={`background:${row.value}`}></span>
                <code>--{row.name}</code>
                <span class="tok-value">{row.value}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="tok-fonts">
          <h2 id="tok-fonts">Fonts</h2>
          <ul class="ruled tok-list">
            {fontTokens.map((row) => (
              <li class="tok-token tok-font">
                <code>--{row.name}</code>
                <span class="tok-sample" style={`font-family:${row.value}`}>{row.value}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </WindowChrome>
  </main>
</Layout>

<style>
  .tok-code {
    font-family: var(--font-machine);
    font-size: var(--machine-chip);
    background: var(--panel);
    padding: 0 0.3em;
  }

  .tok-note { margin-bottom: var(--space-3); font-size: var(--fs-caption); color: var(--muted); }

  .tok-demo { display: flex; flex-direction: column; gap: var(--space-3); }

  .tok-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }

  .tok-text { flex-direction: column; align-items: flex-start; gap: 4px; }

  .prose .tok-text p + p { margin-top: 0; }

  .tok-ink { color: var(--ink); }
  .tok-ink-2 { color: var(--ink-2); }
  .tok-muted { color: var(--muted); }

  .prose .tok-block {
    display: block;
    width: 100%;
    padding: var(--space-2);
    border: 1px solid var(--grey-light);
    background: var(--paper);
  }

  .tok-card {
    width: 100%;
    padding: var(--space-2) var(--space-3);
    background: var(--panel);
    border: 1px solid var(--ink);
  }

  .tok-card-label { display: block; margin-bottom: var(--space-1); text-transform: none; }

  .tok-card-inner {
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--ink);
    font-size: var(--fs-small);
  }

  .tok-list { max-width: none; }

  .tok-token {
    display: grid;
    grid-template-columns: 24px minmax(10rem, 14rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
  }

  .prose .ruled > li.tok-token { padding: var(--space-1) 0; }

  .tok-font { grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr); }

  .tok-swatch {
    width: 24px;
    height: 24px;
    border: 1px solid var(--ink);
  }

  .prose .tok-token code { background: none; padding: 0; }

  .tok-value { font-family: var(--font-machine); font-size: var(--machine-label); color: var(--muted); }

  .tok-sample { color: var(--ink); overflow-wrap: anywhere; }

  @media (max-width: 480px) {
    .tok-token { grid-template-columns: 24px minmax(0, 1fr); }
    .tok-value { grid-column: 2; }
    .tok-font { grid-template-columns: 1fr; }
  }
</style>
