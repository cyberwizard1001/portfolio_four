---
// About page, ported to the v8 system. Built from parts used elsewhere on the site:
// a case-study style header with the headshot in a screen frame, the home page's
// "at a glance" ruled list, the case study route for the career timeline (with each
// project's device linking to its case study), open prose and the Mac buttons.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Device from '../components/Device.astro';
import { timeline } from '../data/timeline.ts';

const base = import.meta.env.BASE_URL;
const projects = await getCollection('projects');
const titleFor = (slug?: string) => projects.find((p) => p.id === slug)?.data.title;

const lookingFor = [
  { label: 'Role', value: 'Product Designer / UX Designer, research-led, comfortable building' },
  { label: 'Level', value: 'Mid-level, looking to learn and grow' },
  { label: 'Domains', value: 'Fintech & insurance, health-adjacent products, anything with real constraints and real-world impact for users' },
  { label: 'Ways of working', value: 'Remote/hybrid-friendly, UK-based. Happy embedded in a product team or owning research and UX end-to-end.' },
  { label: 'What I bring', value: 'Research that changes the design, not research that decorates it. The ability to prototype and build, so ideas could get tested in the real product instead of a static prototype.' },
];
---

<Layout title="About — Nirmal">
  <main id="main-content" class="page ab">
    <header class="ab-head">
      <div class="ab-intro">
        <a href={base} class="t-ui ab-back">← back to home</a>
        <h1 class="ab-title">Nirmal Karthikeyan</h1>
        <p class="ab-lead">
          I'm a product designer with a penchant for what's new, but with the attention to detail to still ensure that
          every scenario gets accounted for. You'll find me urgently scribbling down ideas for new features while I'm running
          usability sessions evaluating forms. My processes are constantly evolving as I learn more about the world of UX, but
          my decisions are always backed by good research within the constraints of what's possible. I can design detailed components
          and complete design systems and prototype new features in code for testing. Good design, to me, is about being honest
          with users and always keeping in mind that I'm not the end-user.
        </p>
      </div>
      <figure class="screen-frame ab-photo">
        <img src={`${base}images/about/pfp.svg`} alt="Pixel-art portrait of Nirmal" width="256" height="320" class="ab-photo-img" />
      </figure>
    </header>

    <section class="ab-section" aria-labelledby="looking-h">
      <h2 id="looking-h" class="t-label ab-label">looking for</h2>
      <dl class="ab-glance">
        {lookingFor.map((item) => (
          <div class="ab-glance-row">
            <dt class="t-label">{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="ab-section" aria-labelledby="timeline-h">
      <h2 id="timeline-h" class="section-title ab-h2">Career timeline</h2>
      <ol class="tl">
        {timeline.map((entry, i) => {
          const title = titleFor(entry.project);
          return (
            <li class="tl-entry">
              <span class:list={['tl-dot', { first: i === 0, last: i === timeline.length - 1 }]} aria-hidden="true"></span>
              <div class="tl-content">
                <h3 class="tl-org">{entry.org}</h3>
                <p class="tl-meta">
                  <span class="tl-role">{entry.title}</span>
                  <span class="t-label tl-dates">{entry.dates}</span>
                </p>
                <p class="tl-body">{entry.body}</p>
                {entry.project && title && (
                  <a href={`${base}projects/${entry.project}/`} class="tl-case">
                    {entry.device && <Device name={entry.device} scale={3} project={entry.project} />}
                    <span class="t-action action-link">open case study ↗<span class="visually-hidden">: {title}</span></span>
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="ab-section" aria-labelledby="beyond-h">
      <h2 id="beyond-h" class="section-title ab-h2">Beyond the work</h2>
      <p class="ab-prose">
        When I'm not designing, I read, I write about product and UX and computers on
        <a href="https://medium.com/@nirmalkarthikeyan" target="_blank" rel="noopener">Medium</a>,
        I build small things for fun, mostly so I don't forget my CS roots, and explore the changing world of technology.
      </p>
    </section>

    <section class="ab-cta" aria-label="Get in touch">
      <p class="ab-cta-text">Open for collaboration.</p>
      <div class="ab-cta-buttons">
        <a href={`${base}contact`} class="mbtn go def">Get in touch</a>
        <a href={`${base}Resume.pdf`} target="_blank" rel="noopener" class="mbtn">View CV</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .ab { padding-bottom: var(--space-6); }

  /* Header: set like a case study's, with the headshot as the one framed artefact. */
  .ab-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: var(--space-5);
    align-items: end;
    padding: 56px 0 var(--space-5);
  }

  .ab-back { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 20px; }

  .ab-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h1);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .ab-lead {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 62ch;
  }

  .ab-photo { margin: 0; }
  /* Pixel art: keep edges crisp at any size. */
  .ab-photo-img { display: block; width: 100%; height: auto; image-rendering: pixelated; }

  /* Sections share the case study rhythm and measure. */
  .ab-section { padding-bottom: var(--space-6); }

  .ab-label { display: block; margin-bottom: var(--space-2); }

  .ab-h2 { margin-bottom: var(--space-4); }

  /* The home page's "at a glance" list: open rows, solid rule at each end. */
  .ab-glance { border-bottom: 1px solid var(--ink); }

  .ab-glance-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-top: 1px dashed var(--rule);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .ab-glance-row:first-child { border-top: 1px solid var(--ink); }
  .ab-glance-row dd { max-width: var(--measure); }

  /* Career timeline: the case study route. Dotted ink line, bevelled title-bar
     boxes as markers; the current role is tangerine, the earliest filled ink. */
  .tl { list-style: none; position: relative; }

  .tl::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 8px;
    bottom: 40px;
    border-left: 2px dotted var(--ink);
  }

  .tl-entry { position: relative; padding: 0 0 var(--space-5) 64px; }
  .tl-entry:last-child { padding-bottom: 0; }

  .tl-dot {
    position: absolute;
    left: 14px;
    top: 8px;
    width: 14px;
    height: 14px;
    background: var(--chrome-hi);
    border: 1px solid var(--ink);
    box-shadow: inset 1px 1px 0 var(--paper), inset -1px -1px 0 var(--bevel-lo);
  }

  .tl-dot.first { background: var(--tangerine); box-shadow: none; }
  .tl-dot.last { background: var(--ink); box-shadow: none; }

  .tl-org {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: var(--lh-tight);
  }

  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px var(--space-2);
    margin: 6px 0 var(--space-2);
  }

  .tl-role { font-size: var(--fs-body); color: var(--ink); font-weight: 500; }

  .tl-body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
    max-width: var(--measure);
  }

  /* The project's device sits inside its link, as on the home cards. */
  .tl-case {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    text-decoration: none;
  }

  .tl-case:hover .action-link { text-decoration: underline; }

  .ab-prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
    max-width: var(--measure);
  }

  .ab-prose a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }

  /* Close like the home page: a ruled line, then the Mac buttons. */
  .ab-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }

  .ab-cta-text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
  }

  .ab-cta-buttons { display: flex; flex-wrap: wrap; gap: var(--space-2); }

  @media (max-width: 860px) {
    .ab-head { grid-template-columns: 1fr; gap: var(--space-4); padding-top: 32px; }
    .ab-photo { max-width: 220px; }
    .ab-section { padding-bottom: var(--space-5); }
    .tl::before { left: 6px; }
    .tl-entry { padding-left: 36px; }
    .tl-dot { left: 0; }
  }

  @media (max-width: 480px) {
    .ab-glance-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
