---
// Contact: the ways to reach Nirmal in one window, the short spec sheet as a ruled
// glance list beside it, and the QR code as a framed artefact.
import Layout from '../layouts/Layout.astro';
import DocHeader from '../components/DocHeader.astro';
import WindowChrome from '../components/WindowChrome.astro';
import Device from '../components/Device.astro';

const base = import.meta.env.BASE_URL;

const links = [
  {
    label: 'email',
    value: 'hello@nirmalkarthikeyan.com',
    href: 'mailto:hello@nirmalkarthikeyan.com',
    external: false,
  },
  {
    label: 'linkedin',
    value: 'linkedin.com/in/nirmal-karthikeyan',
    href: 'https://linkedin.com/in/nirmal-karthikeyan',
    external: true,
  },
  {
    label: 'medium',
    value: 'medium.com/@nirmalkarthikeyan',
    href: 'https://medium.com/@nirmalkarthikeyan',
    external: true,
  },
  {
    label: 'cv',
    value: 'View resume / experience',
    href: `${base}Resume.pdf`,
    external: true,
  },
];

const facts = [
  { label: 'role', value: 'UX Researcher & Designer' },
  { label: 'focus', value: 'Product, design systems, Flutter' },
  { label: 'based', value: 'Remote-friendly' },
  { label: 'status', value: 'Open for collaboration' },
];
---

<Layout title="Contact — Nirmal">
  <main id="main-content" class="page doc">
    <DocHeader title="Contact">
      <p class="doc-lead">
        No forms, no friction. If my work resonates, send me an email, scan the QR, or find me on LinkedIn.
      </p>
    </DocHeader>

    <div class="ct-grid">
      <WindowChrome title="contact.md" as="section" class="ct-window" aria-labelledby="ct-talk">
        <h2 id="ct-talk" class="ct-title">Let's talk</h2>
        <p class="ct-desc">
          Best for collaborations, design roles, product conversations, or just a good systems-and-UX chat.
        </p>
        <ul class="ct-links">
          {links.map((l) => (
            <li class="ct-link-row">
              <span class="t-label">{l.label}</span>
              <a
                href={l.href}
                class="ct-link"
                target={l.external ? '_blank' : undefined}
                rel={l.external ? 'noopener' : undefined}
              >
                {l.value}<span aria-hidden="true"> ↗</span>
                {l.external && <span class="visually-hidden"> (opens in new tab)</span>}
              </a>
            </li>
          ))}
        </ul>
      </WindowChrome>

      <div class="ct-side">
        <Device name="phone" scale={4} class="deco ct-device" />
        <dl class="ct-facts">
          {facts.map((f) => (
            <div class="ct-fact">
              <dt class="t-label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>

        <figure class="ct-qr">
          <a class="screen-frame ct-qr-link" href="mailto:hello@nirmalkarthikeyan.com" aria-label="Email hello@nirmalkarthikeyan.com">
            <img src={`${base}images/qr-email.svg`} alt="QR code to email Nirmal" class="ct-qr-img" />
          </a>
          <figcaption class="t-label ct-qr-cap">Scan to email me</figcaption>
        </figure>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ct-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr);
    gap: var(--space-5);
    align-items: start;
  }

  .ct-window :global(.win-body) { padding: var(--space-4); }

  .ct-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    margin-bottom: var(--space-2);
  }

  .ct-desc {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
    max-width: var(--measure);
    margin-bottom: var(--space-4);
  }

  /* Ruled like the home page's glance list. The label sits outside the link, so no
     pixel type is clickable. */
  .ct-links { list-style: none; border-bottom: 1px solid var(--ink); }

  .ct-link-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    border-top: 1px dashed var(--rule);
  }

  .ct-link-row:first-child { border-top: 1px solid var(--ink); }

  .ct-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-body);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .ct-side { display: flex; flex-direction: column; gap: var(--space-4); }

  .ct-facts { border-bottom: 1px solid var(--ink); }

  .ct-fact {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-top: 1px dashed var(--rule);
    font-size: var(--fs-body);
  }

  .ct-fact:first-child { border-top: 1px solid var(--ink); }

  .ct-qr { margin: 0; align-self: start; }

  .ct-qr-link { width: 200px; }

  .ct-qr-img { padding: var(--space-2); image-rendering: pixelated; }

  .ct-qr-cap { margin-top: var(--space-2); }

  @media (max-width: 860px) {
    .ct-grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .ct-window :global(.win-body) { padding: var(--space-3) 20px; }
  }

  @media (max-width: 480px) {
    .ct-link-row,
    .ct-fact { grid-template-columns: 1fr; gap: 0; }
  }
</style>
