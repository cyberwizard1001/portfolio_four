---
import Layout from '../layouts/Layout.astro';
import DocHeader from '../components/DocHeader.astro';
import WindowChrome from '../components/WindowChrome.astro';

const base = import.meta.env.BASE_URL;
const lastUpdated = '29 September 2026';

const fixed = [
  {
    title: 'Main landmark & skip link',
    body: 'No page had a <main> region, so screen-reader users had no way to jump past the repeated top bar. Every page now wraps its content in <main id="main-content">, and a skip-link is the first focusable element on every page.',
  },
  {
    title: 'Motion respects your preference',
    body: 'The terminal on the homepage played a scripted typing animation regardless of system settings. It now checks prefers-reduced-motion and renders instantly when motion is reduced.',
  },
  {
    title: 'Visible focus on text inputs',
    body: 'A few inputs (the terminal command line, the vim-style search) had outline: none with nothing to replace it, so tabbing to them showed no focus ring. They now get a visible outline on :focus-visible.',
  },
  {
    title: 'Decorative ASCII art hidden from screen readers',
    body: 'Large ASCII banners in the terminal were read aloud character-by-character. They are now marked aria-hidden, and the live command output area announces results via aria-live.',
  },
  {
    title: 'Keyboard focus stays visible in scrolling windows',
    body: 'The case study and documentation windows scroll their content as the page scrolls. Tabbing to a link further down used to scroll the window body on its own, and the next page scroll pushed the focused link out of view. Focus now scrolls the page instead, so the focused element stays on screen.',
  },
  {
    title: 'Consistent focus ring',
    body: 'Links, cards and top bar controls fell back to the browser default focus ring, which is hard to see. Every focusable element now gets a 2px outline in the current accent colour.',
  },
  {
    title: 'Less noise for screen readers',
    body: 'The typing hint on the homepage was a live region that changed every 45ms, so screen readers kept interrupting. It is now hidden from assistive tech, with a static version of the hint in its place. Carousels no longer announce every automatic slide change, and off-screen slides are hidden.',
  },
  {
    title: 'Carousel pause button',
    body: 'Image carousels advance every 7 seconds. They used to pause only while hovered or focused. Each one now has a pause/play button.',
  },
  {
    title: 'Reduced motion, everywhere',
    body: 'Blinking cursors, pulsing badges and the homepage typing hint now stop when your system asks for reduced motion, not just the terminal intro.',
  },
  {
    title: 'Tooltips you can hover',
    body: 'Glossary tooltips in case studies closed as soon as the pointer left the underlined word, so you could not move onto the tooltip to read it. They now stay open while the pointer is over either one.',
  },
  {
    title: 'Headings and landmarks',
    body: 'Homepage section titles were styled text, so project cards jumped from h1 to h3. Section titles are now h2s, the footer heading levels follow on, the top bar links sit in a nav landmark, and links that open a new tab say so.',
  },
  {
    title: 'Colour contrast',
    body: 'Every text colour token was checked against every background token. Pairings below 4.5:1 have been adjusted until every one passes WCAG AA.',
  },
];

const ongoing = [
  'Alt text on project gallery images is sourced from each case study\'s frontmatter — worth a periodic re-read for quality, not just presence.',
  'Colour contrast is checked with a script over every text/background token pairing, but not yet on text laid over images.',
];
---

<Layout title="Accessibility — Nirmal">
  <main id="main-content" class="page doc">
    <DocHeader title="Accessibility">
      <p class="doc-lead">
          What I checked, what I fixed, and what's still on the list. Last reviewed {lastUpdated}.
        </p>
    </DocHeader>

    <WindowChrome title="accessibility.md" as="article" class="doc-window">
      <div class="prose">
        <h2>How this gets checked</h2>
        <p>
          This site is read by a screen reader and walked through by keyboard, not just clicked through in a
          browser. The audit covers landmarks and skip navigation, keyboard access on every interactive control,
          visible focus states, motion preferences, colour contrast across all five workspaces, and whether
          decorative content is hidden from assistive tech rather than read aloud as noise.
        </p>

        <h2>Fixed in the last pass</h2>
        <ul class="ruled">
          {fixed.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>

        <h2>Still on the list</h2>
        <ul>
          {ongoing.map((line) => <li>{line}</li>)}
        </ul>

        <h2>Found something?</h2>
        <p>
          If something doesn't work with a keyboard, screen reader, or any assistive tech, that's a bug —
          <a href={`${base}contact`}>tell me about it</a> and I'll fix it.
        </p>
      </div>
    </WindowChrome>
  </main>
</Layout>
