---
// SCRATCH: device experiments for case studies. Not linked from anywhere.
// Delete this file (and the scratch folder) before deploying.
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Device from '../../components/Device.astro';
import WindowChrome from '../../components/WindowChrome.astro';
import ProjectScreen from '../../components/ProjectScreen.astro';
import { buildStops } from '../../lib/caseStudy';

const slugs = ['pet-insurance-checkout', 'direct-quote-flow', 'perro-onboarding', 'counselling-companions'];
const base = import.meta.env.BASE_URL;

const projects = await Promise.all(slugs.map(async (slug) => {
  const p = (await getCollection('projects')).find((x) => x.id === slug)!;
  const { headings } = await render(p);
  const { stops } = buildStops(p.data.sections ?? [], headings);
  return {
    slug,
    title: p.data.title,
    device: p.data.device!,
    outcome: p.data.outcomeValue ?? p.data.oneliner ?? '',
    filename: p.data.filename,
    stops: stops.map((s) => s.name),
    image: (p.data.sections ?? []).flatMap((s: any) => s.props?.images?.[0]?.src ?? s.props?.image ?? []).find(Boolean),
  };
}));
const src = (i?: string) => (i ? `${base}${i.replace(/^\//, '')}` : undefined);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout title="Scratch: devices">
  <main id="main-content" class="page sx">
    <header class="sx-head">
      <p class="t-label">scratch · not linked · delete before deploy</p>
      <h1 class="sx-h1">One device per project</h1>
      <p class="sx-lead">Five ways to let each project's device carry the case study. The system stays the same on every page; only the device, and what its screen says, changes. Each idea is shown across four projects so you can judge cohesion and distinctiveness at the same time.</p>
    </header>

    <!-- 1 -->
    <section class="sx-idea">
      <p class="t-label">idea 1</p>
      <h2 class="sx-h2">The device marks every stop</h2>
      <p class="sx-note">The bevelled boxes on the route become small copies of the project's own device. The dotted line is shared; the beads on it are not. First stop lit, the rest dark until you reach them, the last one "arrived".</p>
      <div class="sx-grid">
        {projects.map((p) => (
          <div class="sx-col">
            <p class="sx-proj">{p.title}</p>
            <ol class="r1">
              {p.stops.slice(0, 5).map((name, i) => (
                <li class:list={['r1-stop', { done: i === 0 }]}>
                  <span class="r1-mark"><Device name={p.device} scale={2} static={i === 0} /></span>
                  <span class="t-label">stop {i + 1}</span>
                  <span class="r1-name">{name}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <!-- 2 -->
    <section class="sx-idea">
      <p class="t-label">idea 2</p>
      <h2 class="sx-h2">The home page divider, at every chapter</h2>
      <p class="sx-note">The "selected work ........ [tape] ........ 03 projects" divider from the home page, reused between chapters with the project's device in the middle. It is the clearest echo of the home page, and the device appears a handful of times rather than on every stop.</p>
      {projects.map((p) => (
        <div class="r2">
          <span class="t-label r2-label">stop 06</span>
          <span class="r2-rule"></span>
          <Device name={p.device} scale={4} />
          <span class="r2-rule"></span>
          <span class="t-label r2-label">{p.stops.length} stops</span>
        </div>
      ))}
    </section>

    <!-- 3 -->
    <section class="sx-idea">
      <p class="t-label">idea 3</p>
      <h2 class="sx-h2">The device is the "you are here" readout</h2>
      <p class="sx-note">The route window gets the device in its header, and the device's screen does the job of "you are here", in that project's LCD style. The tangerine number moves onto the device. Everything else in the window is identical across projects.</p>
      <div class="sx-grid">
        {projects.map((p) => (
          <WindowChrome title="route" class="r3">
            <div class="r3-head">
              <Device name={p.device} scale={3} static />
              <div class="r3-lcd">
                <span class="r3-lcd-bar">you are here</span>
                <span class="r3-lcd-big">{pad(3)}<small>/{pad(p.stops.length)}</small></span>
              </div>
            </div>
            <ol class="r3-list">
              {p.stops.slice(0, 4).map((name, i) => (
                <li class:list={['t-ui', { here: i === 2 }]}>{name}</li>
              ))}
            </ol>
          </WindowChrome>
        ))}
      </div>
    </section>

    <!-- 4 -->
    <section class="sx-idea">
      <p class="t-label">idea 4</p>
      <h2 class="sx-h2">Artefacts are shown on the device</h2>
      <p class="sx-note">Every screenshot frame carries a small copy of the device at the left of its title bar, the way a Mac window shows its app's icon. Frames stay identical; the icon says whose work it is. Quiet, and it reads well when someone lands deep in the page.</p>
      <div class="sx-grid sx-grid-2">
        {projects.map((p) => (
          <figure>
            <div class="r4">
              <div class="r4-bar"><Device name={p.device} scale={1} static /><span class="r4-file">{p.filename}</span></div>
              {src(p.image)
                ? <img src={src(p.image)} alt="" />
                : <div class="dither r4-ph"><span class="dither-label">[ image ]</span></div>}
            </div>
          </figure>
        ))}
      </div>
    </section>

    <!-- 5 -->
    <section class="sx-idea">
      <p class="t-label">idea 5</p>
      <h2 class="sx-h2">The device bookends the journey</h2>
      <p class="sx-note">The device appears at full size twice: at the top of the case study with its screen dark, and at "arrived" with its screen lit and showing the outcome. The story is told between the two, which gives every case study the same beginning and ending without making them look alike.</p>
      <div class="sx-grid sx-grid-2">
        {projects.map((p) => (
          <div class="r5">
            <div class="r5-end">
              <Device name={p.device} scale={5} />
              <p class="t-label">stop 1 · screen off</p>
            </div>
            <div class="r5-line" aria-hidden="true"></div>
            <div class="r5-end">
              <div class="r5-arrive">
                <Device name={p.device} scale={5} static />
                <div class="r5-screen"><ProjectScreen slug={p.slug} /></div>
              </div>
              <p class="t-label">stop {p.stops.length} · arrived</p>
              <p class="r5-outcome"><span class="hl">{p.outcome}.</span></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="sx-idea">
      <p class="t-label">mix</p>
      <h2 class="sx-h2">My suggestion</h2>
      <p class="sx-note">Ideas 2, 3 and 4 together. The divider gives each chapter break the home page's rhythm, the route window's readout makes the device useful rather than decorative, and the frame icon ties every artefact back to its project. Idea 1 is the most distinctive, but sixteen devices down one line starts to feel busy on a long case study.</p>
    </section>
  </main>
</Layout>

<style>
  .sx { padding-bottom: 120px; }
  .sx-head { padding: 56px 0 24px; }
  .sx-h1 { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h1); line-height: 1.05; margin: 12px 0 16px; }
  .sx-lead, .sx-note { max-width: var(--measure); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--ink-2); }
  .sx-idea { padding: 72px 0 24px; border-top: 2px dotted var(--ink); margin-top: 48px; }
  .sx-h2 { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h2); line-height: var(--lh-tight); margin: 6px 0 12px; }
  .sx-note { margin-bottom: 40px; }
  .sx-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 40px 32px; align-items: start; }
  .sx-grid-2 { grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); }
  .sx-proj { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h3); line-height: var(--lh-tight); margin-bottom: 20px; min-height: 2.4em; }

  /* 1 */
  .r1 { list-style: none; position: relative; padding-left: 0; }
  .r1::before { content: ''; position: absolute; left: 23px; top: 10px; bottom: 10px; border-left: 2px dotted var(--ink); }
  .r1-stop { position: relative; display: grid; grid-template-columns: 48px 1fr; column-gap: 12px; padding-bottom: 24px; }
  .r1-mark { grid-row: span 2; display: flex; justify-content: center; background: var(--paper); position: relative; padding: 4px 0; align-self: start; }
  .r1-name { font-size: var(--fs-small); line-height: 1.4; }

  /* 2 */
  .r2 { display: flex; align-items: center; gap: 28px; padding: 18px 0; }
  .r2-label { color: var(--ink); white-space: nowrap; }
  .r2-rule { flex: 1; border-top: 2px dotted var(--ink); }

  /* 3 */
  .r3-head { display: flex; align-items: center; gap: 14px; padding: 14px; border-bottom: 1px solid var(--ink); }
  .r3-lcd { flex: 1; --lcd: #DADFD2; background: var(--lcd); border: 2px solid var(--grey-dark); border-radius: 6px; font-family: var(--font-machine); color: var(--grey-dark); overflow: hidden; }
  .r3-lcd-bar { display: block; background: var(--grey-dark); color: var(--lcd); font-size: var(--machine-label); padding: 2px 8px; }
  .r3-lcd-big { display: block; font-size: 32px; line-height: 1; padding: 8px 8px 6px; }
  .r3-lcd-big small { font-size: var(--machine-count); color: #5a6050; }
  .r3-list { list-style: none; }
  .r3-list li { padding: 10px 14px; border-top: 1px dashed var(--rule); font-size: var(--fs-ui); }
  .r3-list li:first-child { border-top: none; }
  .r3-list li.here { background: var(--tangerine-tint); }

  /* 4 */
  .r4 { border: 1px solid var(--ink); box-shadow: var(--win-shadow); background: var(--paper); }
  .r4-bar { height: 22px; display: flex; align-items: center; gap: 8px; padding: 0 6px; border-bottom: 1px solid var(--ink); background: repeating-linear-gradient(to bottom, var(--chrome-hi) 0 2px, var(--chrome-lo) 2px 3px); }
  .r4-bar :global(svg) { background: var(--chrome-hi); padding: 1px 3px; box-sizing: content-box; }
  .r4-file { font-family: var(--font-machine); font-size: var(--machine-label); background: var(--chrome-hi); padding: 0 6px; line-height: 18px; }
  .r4 img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .r4-ph { aspect-ratio: 16 / 10; }

  /* 5 */
  .r5 { display: grid; grid-template-columns: 1fr; gap: 0; padding: 24px; border-top: 1px solid var(--ink); }
  .r5-end { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .r5-line { height: 64px; margin-left: 30px; border-left: 2px dotted var(--ink); }
  .r5-arrive { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .r5-screen { width: 260px; }
  .r5-outcome { font-size: var(--fs-lead); font-weight: 600; }

  @media (max-width: 860px) {
    .sx-grid-2 { grid-template-columns: 1fr; }
    .r2 { gap: 12px; }
  }
</style>
