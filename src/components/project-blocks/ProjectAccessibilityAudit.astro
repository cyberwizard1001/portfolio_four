---
interface A11yIssue {
  issue: string;
  description: string;
  severity: 'critical' | 'serious' | 'moderate' | 'minor';
  wcagCriterion?: string;
  fix?: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  issues: A11yIssue[];
  title?: string;
  intro?: string;
}

const { issues, title = 'Accessibility audit', intro, hideHeading } = Astro.props;

const severityMeta: Record<string, { label: string; color: string }> = {
  critical: { label: 'Critical', color: '#dc2626' },
  serious: { label: 'Serious', color: '#d97706' },
  moderate: { label: 'Moderate', color: '#2563eb' },
  minor: { label: 'Minor', color: '#6b7280' },
};

const counts: Record<string, number> = {};
for (const issue of issues) {
  counts[issue.severity] = (counts[issue.severity] ?? 0) + 1;
}
---

<section class="proj-a11y proj-section">
  {!hideHeading && <h2 class="proj-a11y-title section-title">{title}</h2>}
  {intro && <p class="proj-a11y-intro">{intro}</p>}

  <div class="proj-a11y-summary">
    {Object.entries(counts).map(([severity, count]) => {
      const meta = severityMeta[severity];
      return (
        <span class="proj-a11y-chip" style={`--chip-color: ${meta.color}`}>
          <span class="proj-a11y-dot"></span>
          {count} {meta.label}
        </span>
      );
    })}
  </div>

  <div class="proj-a11y-table">
    {issues.map((issue) => {
      const meta = severityMeta[issue.severity];
      return (
        <div class="proj-a11y-row">
          <div class="proj-a11y-row-top">
            <span class="proj-a11y-severity" style={`--chip-color: ${meta.color}`}>
              <span class="proj-a11y-severity-dot"></span>
              {meta.label}
            </span>
            {issue.wcagCriterion && <span class="proj-a11y-wcag">{issue.wcagCriterion}</span>}
          </div>
          <h3 class="proj-a11y-issue">{issue.issue}</h3>
          <p class="proj-a11y-description">{issue.description}</p>
          {issue.fix && <p class="proj-a11y-fix"><span class="proj-a11y-fix-icon">✓</span>{issue.fix}</p>}
        </div>
      );
    })}
  </div>
</section>

<style>
  /* Severity is carried by the word, not a colour, so the audit stays in the
     site's two-accent palette. Rows are open and divided by rules. */
  .proj-a11y-title {
    margin-bottom: var(--space-1);
  }

  .proj-a11y-intro {
    color: var(--ink-2);
    margin-bottom: var(--space-3);
  }

  .proj-a11y-summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .proj-a11y-chip,
  .proj-a11y-severity {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-machine);
    font-size: var(--machine-chip);
    font-weight: 400;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: var(--radius-sm);
    padding: 4px 11px;
  }

  .proj-a11y-dot,
  .proj-a11y-severity-dot { display: none; }

  .proj-a11y-table {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .proj-a11y-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-a11y-row:first-child { border-top: none; }

  .proj-a11y-row-top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .proj-a11y-issue {
    font-size: var(--fs-h3);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
    line-height: var(--lh-tight);
  }

  .proj-a11y-wcag {
    font-size: var(--fs-caption);
    color: var(--muted);
  }

  .proj-a11y-description {
    color: var(--ink-2);
  }

  .proj-a11y-fix {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--ink);
  }

  .proj-a11y-fix-icon {
    flex-shrink: 0;
    color: var(--muted);
  }
</style>
