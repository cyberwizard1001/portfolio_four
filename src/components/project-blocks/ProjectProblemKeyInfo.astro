---
import { jargonify } from '../../lib/jargon';

interface InfoItem {
  label: string;
  value: string;
}

interface BriefFinding {
  label: string;
  body: string;
}

interface Props {
  problemBody: string;
  contextBody?: string;
  briefFindings?: BriefFinding[];
  infoItems: InfoItem[];
  image?: string;
  imageAlt?: string;
}

const { problemBody, contextBody, briefFindings, infoItems, image, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
const imageSrc = image ? `${base}${image.replace(/^\//, '')}` : undefined;
---

<section class="proj-pki proj-section">
  <div class="proj-pki-narrative">
    <span class="proj-pki-label t-label">Problem</span>
    <p class="proj-pki-body">{problemBody}</p>
    <span class="proj-pki-label t-label">Brief</span>
    {briefFindings ? (
      <ul class="proj-pki-findings">
        {briefFindings.map((f) => (
          <li class="proj-pki-finding">
            <span class="proj-pki-finding-label">{f.label}</span>
            <p class="proj-pki-finding-body">{f.body}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="proj-pki-context">{contextBody}</p>
    )}
    {imageSrc && (
      <span class="screen-frame proj-pki-image"><img src={imageSrc} alt={imageAlt ?? ''} loading="lazy" /></span>
    )}
  </div>
  <dl class="proj-pki-panel">
    {infoItems.map((item) => (
      <div class="proj-pki-info-item">
        <dt class="proj-pki-info-label t-label">{item.label}</dt>
        <dd class="proj-pki-info-value" set:html={jargonify(item.value)} />
      </div>
    ))}
  </dl>
</section>

<style>
  /* Narrative first, then the brief panel under it. Three side-by-side columns
     would drop under 300px in a stop, so each item is a row with a label column. */
  .proj-pki-label {
    display: block;
    margin-bottom: var(--space-1);
  }

  .proj-pki-body {
    margin-bottom: var(--space-3);
  }

  .proj-pki-findings {
    list-style: none;
  }

  .proj-pki-finding {
    padding: var(--space-2) 0;
    border-bottom: 1px dashed var(--rule);
  }

  .proj-pki-finding:first-child {
    padding-top: 0;
  }

  .proj-pki-finding:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .proj-pki-finding-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-1);
  }

  .proj-pki-image {
    margin-top: var(--space-3);
  }

  .proj-pki-panel {
    margin-top: var(--space-4);
    border-bottom: 1px solid var(--ink);
  }

  .proj-pki-info-item {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-pki-info-item:first-child { border-top: 1px solid var(--ink); }

  .proj-pki-info-value {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink);
  }

  @container (max-width: 600px) {
    .proj-pki-info-item { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
