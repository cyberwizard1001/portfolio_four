---
import { jargonify } from '../../lib/jargon';

interface FindingItem {
  title: string;
  body: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  title: string;
  items: FindingItem[];
}

const { title, items, hideHeading } = Astro.props;
---

<section class="proj-findings proj-section">
  {!hideHeading && <h2 class="proj-findings-title section-title">{title}</h2>}
  <div class="proj-findings-grid">
    {items.map((item) => (
      <div class="proj-findings-card">
        <h3 class="proj-findings-card-title">{item.title}</h3>
        <p class="proj-findings-card-body" set:html={jargonify(item.body)} />
      </div>
    ))}
  </div>
</section>

<style>
  .proj-findings-title {
    margin-bottom: var(--space-3);
  }

  /* One column, divided like the home page's glance list. */
  .proj-findings-grid {
    border-bottom: 1px solid var(--ink);
  }

  .proj-findings-card {
    padding: var(--space-3) 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-findings-card:first-child { border-top: 1px solid var(--ink); }

  .proj-findings-card-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-1);
  }

  .proj-findings-card-body {
    color: var(--ink-2);
  }
</style>
