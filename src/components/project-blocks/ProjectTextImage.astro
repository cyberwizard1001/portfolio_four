---
import { jargonify } from '../../lib/jargon';
interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  eyebrow: string;
  title: string;
  body: string;
  image: string;
  imageAlt: string;
  /** No longer used: text and image stack, so there is no side to swap. */
  reverse?: boolean;
  raw?: boolean;
}

const { eyebrow, title, body, image, imageAlt, raw = false, hideHeading } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = raw ? image : `${base}${image.replace(/^\//, '')}`;
---

<section class="proj-ti">
  <div class="proj-ti-textbody">
    <span class="proj-ti-eyebrow t-label">{eyebrow}</span>
    {!hideHeading && title && <h2 class="proj-ti-title">{title}</h2>}
    <p class="proj-ti-body" set:html={jargonify(body)} />
  </div>
  <figure class="proj-ti-image">
    <a class="proj-img-link screen-frame proj-ti-frame" href={src}>
      <img src={src} alt={imageAlt} />
    </a>
    <figcaption class="proj-caption">{imageAlt}</figcaption>
  </figure>
</section>

<style>
  /* Stacked: eyebrow, text at full measure, then the image at full width. */
  .proj-ti {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0 0 var(--space-4);
  }

  .proj-ti-eyebrow {
    display: block;
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .proj-ti-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-2);
  }

  .proj-ti-body {
    color: var(--ink-2);
  }

  .proj-ti-body :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .proj-ti-image .proj-caption { margin-top: var(--space-2); }
</style>
