---
import { jargonify } from '../../lib/jargon';

type NoteType = 'positive' | 'neutral' | 'tradeoff';

interface DecisionNote {
  type?: NoteType;
  text: string;
}

interface DecisionItem {
  decision: string;
  rationale: string;
  outcome?: string;
  outcomeType?: NoteType;
  /** Extra notes after `outcome`; each gets its own gutter label. */
  notes?: DecisionNote[];
  image?: string;
  imageAlt?: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  decisions: DecisionItem[];
  title?: string;
  intro?: string;
}

const { decisions, title = 'Decision log', intro, hideHeading } = Astro.props;
const base = import.meta.env.BASE_URL;

const noteLabels: Record<NoteType, string> = {
  positive: 'Result',
  neutral:  'Neutral',
  tradeoff: 'Trade-off',
};

const notesFor = (d: DecisionItem): DecisionNote[] => [
  ...(d.outcome ? [{ type: d.outcomeType, text: d.outcome }] : []),
  ...(d.notes ?? []),
];
---

<section class="proj-dlog proj-section">
  {!hideHeading && <h2 class="proj-dlog-title section-title">{title}</h2>}
  {intro && <p class="proj-dlog-intro">{intro}</p>}
  <ol class="proj-dlog-list">
    {decisions.map((d, i) => (
      <li class="proj-dlog-item">
        <span class="proj-dlog-num t-count" aria-hidden="true">{i + 1}</span>
        <div class="proj-dlog-content">
          <h3 class="proj-dlog-decision" set:html={jargonify(d.decision)} />
          <p class="proj-dlog-rationale" set:html={jargonify(d.rationale)} />
          {notesFor(d).map((n) => (
            <div class="proj-dlog-note">
              <span class="proj-dlog-note-label t-label">{noteLabels[n.type ?? 'neutral']}</span>
              <p class="proj-dlog-note-text" set:html={jargonify(n.text)} />
            </div>
          ))}
          {d.image && (
            <figure class="proj-dlog-media">
              <a class="proj-img-link screen-frame proj-dlog-frame" href={`${base}${d.image.replace(/^\//, '')}`}>
                <img src={`${base}${d.image.replace(/^\//, '')}`} alt={d.imageAlt ?? ''} />
              </a>
              {d.imageAlt && <figcaption class="proj-caption">{d.imageAlt}</figcaption>}
            </figure>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .proj-dlog-intro {
    margin-bottom: var(--space-3);
  }

  .proj-dlog-list {
    list-style: none;
  }

  /* Number in a fixed gutter, everything else in one column at full measure. */
  .proj-dlog-item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-dlog-item:first-child {
    padding-top: 0;
    border-top: none;
  }

  .proj-dlog-item:last-child {
    padding-bottom: 0;
  }

  .proj-dlog-num {
    color: var(--muted);
    line-height: 1;
    user-select: none;
  }

  .proj-dlog-decision {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-2);
  }

  .proj-dlog-rationale {
    color: var(--ink-2);
  }

  .proj-dlog-note {
    margin-top: var(--space-3);
  }

  .proj-dlog-note-label {
    display: block;
    margin-bottom: var(--space-1);
  }

  .proj-dlog-media {
    margin-top: var(--space-3);
  }

  .proj-dlog-media .proj-caption { margin-top: var(--space-2); }

  @container (max-width: 420px) {
    .proj-dlog-item { grid-template-columns: 32px minmax(0, 1fr); }
  }
</style>
