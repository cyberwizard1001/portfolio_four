---
interface Props {
  quote: string;
  attribution?: string;
}

const { quote, attribution } = Astro.props;
---

<section class="proj-quote proj-section">
  <p class="proj-quote-text">"{quote}"</p>
  {attribution && <span class="proj-quote-attribution">{attribution}</span>}
</section>

<style>
  .proj-quote {
    max-width: 820px;
  }

  /* Quotes are a voice, so they take the display face. */
  .proj-quote-text {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 500;
    font-style: normal;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--text);
  }

  /* A full sentence, so the text face rather than pixel type. */
  .proj-quote-attribution {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--fs-caption);
    color: var(--muted);
    text-transform: none;
  }
</style>
