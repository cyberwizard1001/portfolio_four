---
import { jargonify } from '../../lib/jargon';
interface CarouselImage {
  src: string;
  alt: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  eyebrow: string;
  title: string;
  body: string;
  images: CarouselImage[];
  /** No longer used: text and carousel stack, so there is no side to swap. */
  reverse?: boolean;
  raw?: boolean;
}

const { eyebrow, title, body, images, raw = false, hideHeading } = Astro.props;
const base = import.meta.env.BASE_URL;
const srcFor = (img: CarouselImage) => (raw ? img.src : `${base}${img.src.replace(/^\//, '')}`);
---

<section class="proj-car">
  <div class="proj-car-textbody">
    <span class="proj-car-eyebrow t-label">{eyebrow}</span>
    {!hideHeading && <h2 class="proj-car-title">{title}</h2>}
    <p class="proj-car-body" set:html={jargonify(body)} />
  </div>
  {/* A group, not a region: the stop's own section already carries the same name.
       Without JS every slide shows, stacked, with its own caption. The script adds
       .js-carousel, which turns it into the one-at-a-time carousel. */}
  <div
    class="proj-carousel"
    role="group"
    aria-roledescription="carousel"
    aria-label={title}
  >
    <div class="proj-carousel-panel screen-frame">
      <div class="proj-carousel-stage">
        <div class="proj-carousel-viewport">
          <div class="proj-carousel-track">
            {images.map((img) => (
              <figure class="proj-carousel-slide">
                <a class="proj-img-link" href={srcFor(img)}>
                  <img src={srcFor(img)} alt={img.alt} />
                </a>
                <figcaption class="proj-caption proj-carousel-slide-cap">{img.alt}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <button type="button" class="proj-carousel-btn proj-carousel-prev" aria-label="Previous image">‹</button>
        <button type="button" class="proj-carousel-btn proj-carousel-next" aria-label="Next image">›</button>
      </div>
      <div class="proj-carousel-controls">
        {images.length > 5 ? (
          <div class="proj-carousel-counter t-count" aria-hidden="true">
            <span class="proj-carousel-counter-current">1</span>/<span>{images.length}</span>
          </div>
        ) : (
          <div class="proj-carousel-dots">
            {images.map((_, i) => (
              <button
                type="button"
                class="proj-carousel-dot"
                aria-label={`Slide ${i + 1} of ${images.length}`}
                aria-current={i === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
        )}
      </div>
    </div>
    <p class="proj-caption proj-carousel-caption" hidden>
      {images.map((img, i) => (
        <span class="proj-carousel-cap" data-active={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>{img.alt}</span>
      ))}
    </p>
    <span class="proj-carousel-status" aria-live="polite"></span>
  </div>
</section>

<style>
  /* Stacked: eyebrow, text at full measure, then the carousel at full width. */
  .proj-car {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 0 0 var(--space-4);
  }

  .proj-car-eyebrow {
    display: block;
    line-height: 1;
    margin-bottom: var(--space-1);
  }

  .proj-carousel {
    position: relative;
    outline: none;
  }

  .proj-carousel:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .proj-car-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-2);
  }

  .proj-car-body {
    color: var(--ink-2);
  }

  .proj-car-body :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .proj-carousel-stage {
    position: relative;
  }

  .js-carousel .proj-carousel-viewport {
    overflow: hidden;
  }

  /* Without JS: every slide, one under the other, each with its caption. */
  .proj-carousel-track {
    display: flex;
    flex-direction: column;
  }

  .proj-carousel-slide-cap {
    margin: 0;
    padding: var(--space-1) var(--space-2) var(--space-2);
    background: var(--paper);
  }

  .proj-carousel-slide + .proj-carousel-slide {
    border-top: 1px solid var(--ink);
  }

  .proj-carousel:not(.js-carousel) .proj-carousel-btn,
  .proj-carousel:not(.js-carousel) .proj-carousel-controls {
    display: none;
  }

  .js-carousel .proj-carousel-track {
    flex-direction: row;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .js-carousel .proj-carousel-slide + .proj-carousel-slide {
    border-top: none;
  }

  .js-carousel .proj-carousel-slide-cap {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-carousel-track {
      transition: none;
    }
  }

  /* The stage never changes height. Every slide stretches to the tallest one in
     the set (flex rows stretch by default), and each image sits centred on a
     panel inside it, so shorter or narrower images are letterboxed instead of
     resizing the page. Very tall images are capped so one phone screenshot
     can't make the whole carousel taller than the screen. */
  .proj-carousel-slide {
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    margin: 0;
    background: var(--panel);
  }

  .proj-carousel-slide .proj-img-link {
    align-self: center;
  }

  .proj-carousel-slide .proj-img-link {
    display: flex;
    justify-content: center;
    max-width: 100%;
  }

  .proj-carousel-slide img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(75vh, 760px);
  }

  /* Every caption is laid out in the same grid cell and only the current one is
     visible, so the caption's height is the longest one's and never jumps. */
  .proj-carousel-caption {
    display: grid;
  }

  .proj-carousel-caption[hidden] {
    display: none;
  }

  .proj-carousel-cap {
    grid-area: 1 / 1;
    visibility: hidden;
  }

  .proj-carousel-cap[data-active] {
    visibility: visible;
  }

  /* Square bevelled keys, like the window's title-bar boxes. */
  .proj-carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--ink);
    background: var(--chrome-hi);
    box-shadow: inset 1px 1px 0 var(--paper), inset -1px -1px 0 var(--bevel-lo);
    color: var(--ink);
    font-family: var(--font-machine);
    font-size: var(--machine-count);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .proj-carousel-btn:hover {
    color: var(--blue);
    border-color: var(--blue);
  }

  .proj-carousel-btn:active {
    box-shadow: inset -1px -1px 0 var(--paper), inset 1px 1px 0 var(--bevel-lo);
  }

  .proj-carousel-btn:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .proj-carousel-prev {
    left: var(--space-2);
  }

  .proj-carousel-next {
    right: var(--space-2);
  }

  /* Controls sit under the frame, outside the window, beside the caption. */
  .proj-carousel-controls {
    display: flex;
    justify-content: center;
    padding: var(--space-1) 0 0;
  }

  .proj-carousel-dots {
    display: flex;
    align-items: center;
  }

  /* An 8px dot drawn inside a 44px target. */
  .proj-carousel-dot {
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    position: relative;
  }

  .proj-carousel-dot::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink);
    box-sizing: border-box;
  }

  .proj-carousel-dot:hover::before {
    border-color: var(--blue);
  }

  .proj-carousel-dot[aria-current="true"]::before {
    background: var(--blue);
    border-color: var(--blue);
  }

  .proj-carousel-dot:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: -6px;
  }

  .proj-carousel-counter {
    padding: 12px 0;
    color: var(--muted);
    white-space: nowrap;
  }

  .proj-carousel-counter-current {
    color: var(--text);
  }

  .proj-carousel-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

</style>

<script>
  // Slides change only on prev, next, a dot, arrow keys or a swipe. Nothing autoplays.
  (function () {
    const carousels = document.querySelectorAll<HTMLElement>('.proj-carousel');

    carousels.forEach((carousel) => {
      const viewport = carousel.querySelector<HTMLElement>('.proj-carousel-viewport');
      const track = carousel.querySelector<HTMLElement>('.proj-carousel-track');
      const slides = carousel.querySelectorAll<HTMLElement>('.proj-carousel-slide');
      const dots = carousel.querySelectorAll<HTMLButtonElement>('.proj-carousel-dot');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.proj-carousel-prev');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.proj-carousel-next');
      const status = carousel.querySelector<HTMLElement>('.proj-carousel-status');
      const counterCurrent = carousel.querySelector<HTMLElement>('.proj-carousel-counter-current');
      if (!viewport || !track || slides.length === 0 || !prevBtn || !nextBtn) return;

      carousel.classList.add('js-carousel');
      carousel.tabIndex = 0;
      carousel.parentElement?.querySelector<HTMLElement>('.proj-carousel-caption')?.removeAttribute('hidden');

      const count = slides.length;
      let index = 0;

      const captions = carousel.parentElement?.querySelectorAll<HTMLElement>('.proj-carousel-cap') ?? [];

      const render = (announce = false) => {
        track.style.transform = `translateX(-${index * 100}%)`;
        slides.forEach((slide, i) => {
          slide.toggleAttribute('data-active', i === index);
          slide.setAttribute('aria-hidden', String(i !== index));
          // Only the visible slide's full-size link is in the tab order.
          const link = slide.querySelector<HTMLAnchorElement>('a');
          if (link) link.tabIndex = i === index ? 0 : -1;
        });
        dots.forEach((dot, i) => dot.setAttribute('aria-current', i === index ? 'true' : 'false'));
        if (status && announce) status.textContent = `Image ${index + 1} of ${count}`;
        if (counterCurrent) counterCurrent.textContent = String(index + 1);
        captions.forEach((cap, i) => {
          cap.toggleAttribute('data-active', i === index);
          if (i === index) cap.removeAttribute('aria-hidden');
          else cap.setAttribute('aria-hidden', 'true');
        });
      };

      const goTo = (i: number) => {
        index = ((i % count) + count) % count;
        render(true);
      };

      const next = () => goTo(index + 1);
      const prev = () => goTo(index - 1);

      prevBtn.addEventListener('click', prev);
      nextBtn.addEventListener('click', next);
      dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

      carousel.addEventListener('keydown', (event) => {
        switch (event.key) {
          case 'ArrowLeft':
            event.preventDefault();
            prev();
            break;
          case 'ArrowRight':
            event.preventDefault();
            next();
            break;
          case 'Home':
            event.preventDefault();
            goTo(0);
            break;
          case 'End':
            event.preventDefault();
            goTo(count - 1);
            break;
        }
      });

      let touchStartX: number | null = null;
      carousel.addEventListener('touchstart', (event) => {
        touchStartX = event.touches[0].clientX;
      }, { passive: true });
      carousel.addEventListener('touchend', (event) => {
        if (touchStartX === null) return;
        const deltaX = event.changedTouches[0].clientX - touchStartX;
        touchStartX = null;
        if (Math.abs(deltaX) < 40) return;
        if (deltaX < 0) next();
        else prev();
      });

      render();
    });
  })();
</script>
