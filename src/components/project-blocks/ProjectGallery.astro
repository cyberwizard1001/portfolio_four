---
interface Props {
  image: string;
  imageAlt: string;
  raw?: boolean;
  contain?: boolean;
}

const { image, imageAlt, raw = false, contain = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const src = raw ? image : `${base}${image.replace(/^\//, '')}`;
---

<section class="proj-gallery">
  <a class:list={['proj-img-link', 'screen-frame', 'proj-gallery-frame', { 'proj-gallery-frame-contain': contain }]} href={src}>
    <img src={src} alt={imageAlt} class="proj-gallery-img" />
  </a>
  <p class="proj-caption proj-gallery-caption">{imageAlt}</p>
</section>

<style>
  .proj-gallery {
    padding: 0 0 var(--space-4);
  }

  .proj-gallery-caption { margin-top: var(--space-2); }

  .proj-gallery-img {
    width: 100%;
    display: block;
  }

  .proj-gallery-frame-contain {
    overflow: hidden;
  }

  .proj-gallery-frame-contain .proj-gallery-img {
    height: 640px;
    object-fit: cover;
    object-position: top;
  }

  @container (max-width: 600px) {
    .proj-gallery-frame-contain .proj-gallery-img { height: 420px; }
  }
</style>
