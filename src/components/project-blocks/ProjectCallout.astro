---
interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  body: string;
  label?: string;
  variant?: 'insight' | 'principle' | 'warning';
}

const { body, label, variant = 'insight', hideHeading } = Astro.props;
---

<section class="proj-callout proj-section">
  <div class:list={['proj-callout-card', `proj-callout-${variant}`]}>
    <div class="proj-callout-content">
      {!hideHeading && label && <span class="proj-callout-label t-label">{label}</span>}
      <p class="proj-callout-body">{body}</p>
    </div>
  </div>
</section>

<style>
  /* Open on the page: a rule above and the body a step up from running text,
     so it reads as the point of the stop without being boxed. */
  .proj-callout-card {
    max-width: var(--measure);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ink);
  }

  .proj-callout-label {
    display: block;
    margin-bottom: var(--space-2);
  }

  .proj-callout-body {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink);
    text-wrap: pretty;
  }

  @container (max-width: 480px) {
    .proj-callout-body { font-size: var(--fs-body); }
  }
</style>
