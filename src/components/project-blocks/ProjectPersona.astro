---
interface Props {
  name: string;
  role: string;
  quote: string;
  goals: string[];
  frustrations: string[];
  eyebrow?: string;
  context?: string;
  contextTags?: string[];
  avatarImage?: string;
  avatarImageAlt?: string;
}

const {
  name,
  role,
  quote,
  goals,
  frustrations,
  eyebrow = 'User persona',
  context,
  contextTags = [],
  avatarImage,
  avatarImageAlt,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const avatarSrc = avatarImage ? `${base}${avatarImage.replace(/^\//, '')}` : undefined;
const initial = name.length > 0 ? name[0].toUpperCase() : '?';
const cleanQuote = quote.trim().replace(/^["“]+/, '').replace(/["”]+$/, '');
---

<section class="proj-persona proj-section">
  <span class="proj-persona-eyebrow t-label">{eyebrow}</span>

  <div class="proj-persona-card">
    <div class="proj-persona-profile">
      <div class="proj-persona-avatar">
        {avatarSrc
          ? <img src={avatarSrc} alt={avatarImageAlt ?? ''} loading="lazy" />
          : initial}
      </div>
      <div class="proj-persona-who">
        <h3 class="proj-persona-name">{name}</h3>
        <span class="proj-persona-role">{role}</span>
        {contextTags.length > 0 && (
          <div class="proj-persona-tags">
            {contextTags.map((tag) => <span class="chip proj-persona-tag">{tag}</span>)}
          </div>
        )}
      </div>
      <blockquote class="proj-persona-quote">
        <p>{cleanQuote}</p>
      </blockquote>
    </div>

    <div class="proj-persona-lists">
      <div class="proj-persona-list">
        <span class="proj-persona-list-label t-label">Goals</span>
        <ul>
          {goals.map((g) => (
            <li>
              <span class="proj-persona-icon t-chip" aria-hidden="true">+</span>
              <span>{g}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="proj-persona-list">
        <span class="proj-persona-list-label t-label">Frustrations</span>
        <ul>
          {frustrations.map((f) => (
            <li>
              <span class="proj-persona-icon t-chip" aria-hidden="true">&minus;</span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {context && (
      <div class="proj-persona-context">
        <span class="proj-persona-context-label t-label">Why she matters</span>
        <p class="proj-persona-context-body">{context}</p>
      </div>
    )}
  </div>
</section>

<style>
  /* Open on the page like the rest of the route: a rule above, the person,
     their words, then goals and frustrations in two ruled columns. */
  .proj-persona-eyebrow {
    display: block;
    margin-bottom: var(--space-1);
  }

  .proj-persona-card {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .proj-persona-profile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) 0;
  }

  /* A square tile with the initial in pixel type, like a desktop icon. */
  .proj-persona-avatar {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--panel);
    border: 1px solid var(--ink);
    box-shadow: inset 1px 1px 0 var(--paper), inset -1px -1px 0 var(--bevel-lo);
    color: var(--ink);
    font-size: var(--machine-count);
    font-weight: 600;
    font-family: var(--font-machine);
    overflow: hidden;
  }

  .proj-persona-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proj-persona-name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
  }

  .proj-persona-role {
    display: block;
    color: var(--ink-2);
    margin-top: 4px;
  }

  .proj-persona-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
  }

  .proj-persona-quote {
    grid-column: 1 / -1;
    margin-top: var(--space-1);
  }

  .proj-persona-quote p {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-style: normal;
    line-height: 1.45;
    color: var(--ink);
  }

  .proj-persona-lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-4);
  }

  .proj-persona-list {
    padding: var(--space-3) 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-persona-list-label {
    display: block;
    margin-bottom: var(--space-2);
  }

  .proj-persona-list ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
  }

  .proj-persona-list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--ink);
  }

  /* The glyph carries the meaning, not the colour. */
  .proj-persona-icon {
    flex-shrink: 0;
    width: 1ch;
    color: var(--muted);
  }

  .proj-persona-context {
    padding: var(--space-3) 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-persona-context-label {
    display: block;
    margin-bottom: var(--space-1);
  }

  @container (max-width: 700px) {
    .proj-persona-lists { grid-template-columns: 1fr; }
  }
</style>
