---
interface GalleryImage {
  src: string;
  alt: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  title?: string;
  images: GalleryImage[];
  raw?: boolean;
}

const { title, images, raw = false, hideHeading } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="proj-gallery-grid proj-section">
  {!hideHeading && title && <h2 class="proj-gallery-grid-title section-title">{title}</h2>}
  <div class="proj-gallery-grid-images">
    {images.map((img) => (
      <a class="proj-img-link screen-frame proj-gallery-grid-item" href={raw ? img.src : `${base}${img.src.replace(/^\//, '')}`}>
        <img src={raw ? img.src : `${base}${img.src.replace(/^\//, '')}`} alt={img.alt} />
      </a>
    ))}
  </div>
</section>

<style>
  .proj-gallery-grid-title {
    margin-bottom: var(--space-3);
  }

  .proj-gallery-grid-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-3);
  }

  .proj-gallery-grid-item {
    display: flex;
    flex-direction: column;
    aspect-ratio: 1.8;
    overflow: hidden;
  }

  .proj-gallery-grid-item img {
    flex: 1;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
</style>
