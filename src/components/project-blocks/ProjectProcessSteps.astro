---
interface ProcessStep {
  title: string;
  body: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  title: string;
  steps: ProcessStep[];
}

const { title, steps, hideHeading } = Astro.props;
---

<section class="proj-steps proj-section">
  {!hideHeading && <h2 class="proj-steps-title section-title">{title}</h2>}
  <div class="proj-steps-list">
    {steps.map((step, i) => (
      <div class="proj-steps-card">
        <span class="proj-steps-num t-count">{i + 1}</span>
        <div class="proj-steps-body">
          <h3 class="proj-steps-step-title">{step.title}</h3>
          <p class="proj-steps-step-body">{step.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .proj-steps-title {
    margin-bottom: var(--space-3);
  }

  /* Cards drop to one column before they get narrow. */
  .proj-steps-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    column-gap: var(--space-4);
    align-items: start;
  }

  .proj-steps-card {
    display: flex;
    gap: var(--space-2);
    border-top: 1px solid var(--ink);
    padding: var(--space-3) 0;
  }

  .proj-steps-num {
    flex-shrink: 0;
    width: 2ch;
    color: var(--muted);
    line-height: var(--lh-tight);
  }

  .proj-steps-step-title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    margin-bottom: var(--space-1);
  }

  .proj-steps-step-body {
    color: var(--ink-2);
  }

  /* Narrow stops: the number sits above the text so the text keeps the width. */
  @container (max-width: 400px) {
    .proj-steps-list { grid-template-columns: 1fr; }
    .proj-steps-card { flex-direction: column; gap: var(--space-1); }
  }
</style>
