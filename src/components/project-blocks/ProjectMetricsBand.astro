---
interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  items: MetricItem[];
}

const { items } = Astro.props;
---

<section class="proj-metrics">
  {items.map((item) => (
    <div class="proj-metrics-item">
      <span class="proj-metrics-value">{item.value}</span>
      <span class="proj-metrics-label">{item.label}</span>
    </div>
  ))}
</section>

<style>
  /* The values are words, not numbers, so they sit at title size over the labels. */
  .proj-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    margin-bottom: var(--space-4);
    border-top: 1px solid var(--ink);
  }

  .proj-metrics-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-3) var(--space-3) 0;
    border-bottom: 1px dashed var(--rule);
  }

  .proj-metrics-item:nth-child(2n) {
    padding-left: var(--space-3);
    border-left: 1px dashed var(--rule);
  }

  .proj-metrics-value {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    color: var(--ink);
  }

  .proj-metrics-label {
    font-size: var(--fs-small);
    color: var(--ink-2);
    line-height: 1.5;
  }

  @container (max-width: 520px) {
    .proj-metrics { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .proj-metrics-item:nth-child(2n) { padding-left: 0; border-left: none; }
  }
</style>
