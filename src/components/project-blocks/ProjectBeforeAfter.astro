---
interface Props {
  beforeTitle: string;
  beforeBody: string;
  afterTitle: string;
  afterBody: string;
}

const { beforeTitle, beforeBody, afterTitle, afterBody } = Astro.props;
---

<section class="proj-ba proj-section">
  <div class="proj-ba-panel">
    <h3 class="proj-ba-title t-label">{beforeTitle}</h3>
    <p class="proj-ba-body">{beforeBody}</p>
  </div>
  <div class="proj-ba-panel">
    <h3 class="proj-ba-title t-label">{afterTitle}</h3>
    <p class="proj-ba-body">{afterBody}</p>
  </div>
</section>

<style>
  /* Two open columns under one rule, side by side while each keeps about 320px. */
  .proj-ba {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    column-gap: var(--space-4);
  }

  .proj-ba-panel {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--ink);
  }

  .proj-ba-title {
    margin-bottom: var(--space-1);
  }

  .proj-ba-body {
    color: var(--ink-2);
  }
</style>
