---
interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  heading?: string;
  body?: string;
}

const { heading, body, hideHeading } = Astro.props;
---

<section class="proj-text proj-section">
  <div class="proj-text-col">
    {!hideHeading && heading && <h2 class="proj-text-heading">{heading}</h2>}
    {body && <p class="proj-text-body">{body}</p>}
    <slot />
  </div>
</section>

<style>
  .proj-text {
    width: 100%;
    box-sizing: border-box;
  }

  /* Prose holds to the reading measure. Components rendered from markdown
     (<ProjectTextImage> and friends) stay at the full column width. */
  .proj-text-col > :global(:is(h1, h2, h3, p, ul, ol, blockquote, .meta-card)) {
    max-width: var(--measure);
  }

  .proj-text-heading {
    font-family: var(--font-machine);
    font-size: var(--machine-label);
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: 0.75rem;
  }

  /* Prose styling for markdown rendered via <Content /> in the default slot */
  .proj-text-col > :global(h1) {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 1rem;
  }

  .proj-text-col > :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 600;
    line-height: var(--lh-tight);
    color: var(--ink);
    margin: var(--space-5) 0 var(--space-3);
  }

  .proj-text-col > :global(h3) {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: var(--lh-tight);
    color: var(--ink);
    margin: var(--space-5) 0 var(--space-2);
  }

  .proj-text :global(p) {
    margin: 0 0 var(--space-2);
  }

  .proj-text :global(em) {
    color: var(--ink);
    font-style: italic;
  }

  .proj-text :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .proj-text :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .proj-text :global(code) {
    font-family: var(--font-machine);
    font-size: 0.85em;
    background: var(--panel);
    color: var(--ink);
    padding: 0.1em 0.4em;
  }

  /* Quotes are a voice, so they take the display face, set open on the page. */
  .proj-text :global(blockquote) {
    margin: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-style: normal;
    line-height: 1.35;
    color: var(--ink);
  }

  .proj-text :global(hr) {
    border: none;
    border-top: 1px dashed var(--rule);
    margin: var(--space-4) 0;
  }

  .proj-text :global(img) {
    width: 100%;
    display: block;
    border: 1px solid var(--ink);
    box-shadow: var(--win-shadow);
    margin: var(--space-2) 0 var(--space-3);
  }

  /* Set like the home page's glance list: open rows, solid rule at each end. */
  .proj-text :global(.meta-card) {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    column-gap: var(--space-3);
    margin: var(--space-3) 0 var(--space-4);
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .proj-text :global(.meta-card > div) {
    display: contents;
  }

  .proj-text :global(.meta-card dt),
  .proj-text :global(.meta-card dd) {
    padding: var(--space-2) 0;
    margin: 0;
    border-top: 1px dashed var(--rule);
  }

  .proj-text :global(.meta-card dt) {
    font-family: var(--font-machine);
    font-size: var(--machine-label);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .proj-text :global(.meta-card dd) {
    color: var(--ink);
  }

  .proj-text :global(.meta-card > div:first-child dt),
  .proj-text :global(.meta-card > div:first-child dd) {
    border-top: none;
  }

  @media (max-width: 600px) {
    .proj-text :global(.meta-card) { grid-template-columns: 1fr; }
    .proj-text :global(.meta-card dd) { border-top: none; padding-top: 0; }
  }
</style>
