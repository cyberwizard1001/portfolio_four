---
import { jargonify } from '../../lib/jargon';

interface HmwItem {
  question: string;
  theme?: string;
}

interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  items: HmwItem[];
  title?: string;
  intro?: string;
}

const { items, title = 'How might we…', intro, hideHeading } = Astro.props;
---

<section class="proj-hmw proj-section">
  <div class="proj-hmw-top">
    <div>
      {!hideHeading && <h2 class="proj-hmw-title section-title">{title}</h2>}
      {intro && <p class="proj-hmw-intro">{intro}</p>}
    </div>
    <span class="proj-hmw-count t-label">{items.length} questions</span>
  </div>
  <div class="proj-hmw-list">
    {items.map((item) => (
      <div class="proj-hmw-row">
        <p class="proj-hmw-question" set:html={jargonify(item.question)} />
        {item.theme && <span class="proj-hmw-theme t-label">{item.theme}</span>}
      </div>
    ))}
  </div>
</section>

<style>
  .proj-hmw-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .proj-hmw-intro {
    margin-top: var(--space-1);
  }

  .proj-hmw-count,
  .proj-hmw-theme {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .proj-hmw-list {
    border-top: 1px solid var(--ink);
  }

  /* Fixed chip column so the questions line up. */
  .proj-hmw-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 11rem;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px dashed var(--rule);
  }

  .proj-hmw-theme { justify-self: start; }

  .proj-hmw-question {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  @container (max-width: 560px) {
    .proj-hmw-row { grid-template-columns: 1fr; gap: var(--space-1); }
    .proj-hmw-top { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
  }
</style>
