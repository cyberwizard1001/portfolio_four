---
interface Props {
  /** Set when a case study stop already shows this heading. */
  hideHeading?: boolean;
  title: string;
  points: string[];
}

const { title, points, hideHeading } = Astro.props;
---

<section class="proj-learnings">
  {!hideHeading && <h2 class="proj-learnings-title section-title">{title}</h2>}
  <ul class="proj-learnings-list">
    {points.map((point) => (
      <li class="proj-learnings-item">
        <span class="proj-learnings-dot"></span>
        <span>{point}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .proj-learnings {
    padding: 0 0 var(--space-4);
  }

  .proj-learnings-title {
    margin-bottom: var(--space-3);
  }

  .proj-learnings-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
  }

  .proj-learnings-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .proj-learnings-dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    background: var(--ink);
    margin-top: 0.7em;
  }

</style>
