---
// Menu bar. Marks the current page with aria-current (tangerine underline).
// On case studies it swaps About, AI and CV for a "Work / title" breadcrumb and a next link.
// Under 860px the links fold behind a Menu button. Without JS the button stays hidden,
// the links wrap in a row and the bar is not sticky.
import Device from './Device.astro';
import type { DeviceName } from '../data/sprites';

interface Props {
  caseStudy?: { title: string; next?: { title: string; href: string; device?: DeviceName } };
}

const { caseStudy } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/g, '');
const current = (key: string) => (path === key ? 'page' : undefined);

const items = [
  { key: 'about', label: 'About' },
  { key: 'ai', label: 'How I use AI' },
];
---

<header class="menubar">
  <div class="page menubar-inner">
    <a href={base} class="mb-home">
      <Device name="pager" scale={2} />
      <span class="t-wordmark">Nirmal Karthikeyan</span>
    </a>
    <button type="button" class="mbtn mb-toggle" aria-expanded="false" aria-controls="main-nav" hidden data-menu-toggle>Menu</button>
    <nav aria-label="Main" id="main-nav" class="mb-nav t-ui">
      <a href={base} aria-current={caseStudy ? undefined : current('')}>Home</a>
      {caseStudy ? (
        <>
          <span class="mb-crumb">
            <a href={`${base}#work`}>Work</a>
            <span class="mb-sep" aria-hidden="true">/</span>
            <span class="mb-here" aria-current="page" title={caseStudy.title}>{caseStudy.title}</span>
          </span>
          {caseStudy.next && (
            <a href={caseStudy.next.href} class="mb-next" title={caseStudy.next.title}>
              {caseStudy.next.device && <Device name={caseStudy.next.device} scale={2} class="mb-next-device" />}
              <span class="mb-next-text">
                <span class="t-label mb-next-label">next stop<span class="visually-hidden">:</span></span>
                <span class="mb-next-title">{caseStudy.next.title}<span aria-hidden="true"> →</span></span>
              </span>
            </a>
          )}
        </>
      ) : (
        <>
          <a href={`${base}#work`}>Work</a>
          {items.map((item) => (
            <a href={`${base}${item.key}`} aria-current={current(item.key)}>{item.label}</a>
          ))}
          <a href={`${base}Resume.pdf`} target="_blank" rel="noopener">CV<span class="visually-hidden"> (opens in new tab)</span></a>
        </>
      )}
      <a href={`${base}contact`} class="mbtn go mb-contact" aria-current={current('contact')}>contact</a>
    </nav>
  </div>
</header>

<style>
  .menubar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .menubar-inner {
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    flex-wrap: wrap;
  }

  .mb-home {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
    color: var(--ink);
  }

  .mb-nav {
    display: flex;
    align-items: center;
    gap: 4px 22px;
    flex-wrap: wrap;
  }

  .mb-nav a:not(.mbtn) {
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .mb-nav a:not(.mbtn):hover { color: var(--blue); text-decoration: underline; }

  /* You are here. */
  .mb-nav a:not(.mbtn)[aria-current='page'],
  .mb-here {
    text-decoration: underline 2px var(--tangerine);
    text-underline-offset: 6px;
  }

  .mb-crumb {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .mb-sep { color: var(--muted); }

  .mb-here {
    max-width: 28ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /* Room for the underline inside the clipped box. */
    padding-bottom: 8px;
    margin-bottom: -8px;
  }

  /* Next stop: its own bordered tab, pushed right, so its title never runs on from the breadcrumb. */
  .mb-nav a.mb-next {
    margin-left: 18px;
    gap: 10px;
    box-sizing: border-box;
    min-height: 44px;
    padding: 2px 12px 2px 8px;
    align-self: center;
    border: 1px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
    background: var(--paper);
    color: var(--blue);
    max-width: 42ch;
  }
  .mb-nav a.mb-next:hover { text-decoration: none; color: var(--blue); }
  .mb-nav a.mb-next:hover .mb-next-title { text-decoration: underline; }
  .mb-nav a.mb-next:active { box-shadow: none; transform: translate(2px, 2px); }
  .mb-next-device { flex: none; }
  @media (max-width: 1240px) {
    .mb-next-device { display: none; }
    .mb-nav a.mb-next { max-width: 32ch; padding-left: 12px; }
  }
  /* Too tight to share the row: the "next stop" section at the end of the page does this job. */
  @media (min-width: 861px) and (max-width: 1180px) {
    .mb-nav a.mb-next { display: none; }
  }
  .mb-next-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .mb-next-title {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .mb-nav a.mb-next:active { transform: none; }
  }

  .mb-contact { min-height: 34px; padding: 0 14px; }

  /* On the contact page: tangerine "you are here", not the blue "click this" primary. */
  .mb-contact[aria-current='page'],
  .mb-contact[aria-current='page']:hover {
    background: var(--tangerine);
    color: var(--ink);
    box-shadow: none;
    cursor: default;
  }

  .mb-toggle { display: none; min-height: 44px; padding: 0 14px; }

  @media (max-width: 860px) {
    /* Without JS the bar scrolls away rather than covering the page. */
    .menubar { position: static; }
    .menubar.js-menu { position: sticky; }

    /* Without JS: the links sit on one row under the name and scroll sideways, rather than
       wrapping and leaving contact stranded on a line of its own. */
    .menubar:not(.js-menu) .mb-nav {
      flex-basis: 100%;
      flex-wrap: nowrap;
      gap: 0 20px;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
      /* Room for the "you are here" underline inside the scroll box. */
      padding-bottom: 6px;
    }
    .menubar:not(.js-menu) .mb-nav > * { flex: none; }

    .js-menu .mb-toggle { display: inline-flex; }

    /* Folded: one 48px row. Open: the links stack under it. */
    .js-menu .mb-nav { display: none; }
    .js-menu.menu-open .mb-nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      flex-basis: 100%;
      gap: 0;
      padding-bottom: 12px;
    }
    .js-menu.menu-open .mb-crumb { flex-wrap: wrap; }
    .js-menu.menu-open .mb-here { max-width: none; white-space: normal; }
    .js-menu.menu-open .mb-contact { margin-top: 8px; }
    .js-menu.menu-open .mb-next { margin: 8px 0 0; max-width: 100%; }
  }

  @media (max-width: 640px) {
    .menubar:not(.menu-open) .mb-next { display: none !important; }
    .mb-here { max-width: 16ch; }
  }

  @media (max-width: 480px) {
    .menubar-inner { padding-block: 2px; }
    .mb-nav { gap: 0 16px; }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.menubar');
  const toggle = bar?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (bar && toggle) {
    bar.classList.add('js-menu');
    toggle.hidden = false;
    const set = (open: boolean) => {
      bar.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    bar.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && bar.classList.contains('menu-open')) {
        set(false);
        toggle.focus();
      }
    });
    // Following an in-page link closes the menu.
    bar.querySelector('nav')?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });
  }
</script>
