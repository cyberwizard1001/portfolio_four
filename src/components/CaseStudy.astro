---
// Case study template, shared by project pages and build pages. The summary hero
// (which carries the TLDR), then the vertical route: the entry's own sections, then
// markdown headings, all on one dotted line with a sticky "route" window beside it.
import RouteWindow from './RouteWindow.astro';
import Device from './Device.astro';
import CaseStudyHero from './CaseStudyHero.astro';
import ImageLightbox from './ImageLightbox.astro';
import ProjectGallery from './project-blocks/ProjectGallery.astro';
import ProjectTextBlock from './project-blocks/ProjectTextBlock.astro';
import ProjectCallout from './project-blocks/ProjectCallout.astro';
import ProjectQuote from './project-blocks/ProjectQuote.astro';
import ProjectMetricsBand from './project-blocks/ProjectMetricsBand.astro';
import ProjectBeforeAfter from './project-blocks/ProjectBeforeAfter.astro';
import ProjectLearnings from './project-blocks/ProjectLearnings.astro';
import ProjectProcessSteps from './project-blocks/ProjectProcessSteps.astro';
import ProjectFindingsGrid from './project-blocks/ProjectFindingsGrid.astro';
import ProjectHowMightWe from './project-blocks/ProjectHowMightWe.astro';
import ProjectDecisionLog from './project-blocks/ProjectDecisionLog.astro';
import ProjectPersona from './project-blocks/ProjectPersona.astro';
import ProjectProblemKeyInfo from './project-blocks/ProjectProblemKeyInfo.astro';
import ProjectTextImage from './project-blocks/ProjectTextImage.astro';
import ProjectImageGalleryGrid from './project-blocks/ProjectImageGalleryGrid.astro';
import ProjectImageCarousel from './project-blocks/ProjectImageCarousel.astro';
import ProjectAccessibilityAudit from './project-blocks/ProjectAccessibilityAudit.astro';
import { buildStops, type Hero, type Section } from '../lib/caseStudy';
import { spriteDataUri, type DeviceName } from '../data/sprites';
import '../styles/jargon.css';

interface Props {
  slug: string;
  title: string;
  filename: string;
  eyebrowLine: string;
  device?: DeviceName;
  outcomeValue?: string;
  outcomeLabel?: string;
  oneliner?: string;
  sections: Section[];
  hero?: Hero;
  tldrBody?: string;
  headings: { depth: number; slug: string; text: string }[];
  next?: { title: string; href: string; device?: DeviceName };
  /** Whether the entry has a markdown body, passed as the default slot. */
  hasBody?: boolean;
}

const {
  slug, title, filename, eyebrowLine, device, outcomeValue, outcomeLabel, oneliner,
  sections, hero, tldrBody, headings, next, hasBody = false,
} = Astro.props;

const blockComponents: Record<string, any> = {
  ProjectGallery,
  ProjectTextBlock,
  ProjectCallout,
  ProjectQuote,
  ProjectMetricsBand,
  ProjectBeforeAfter,
  ProjectLearnings,
  ProjectProcessSteps,
  ProjectFindingsGrid,
  ProjectHowMightWe,
  ProjectDecisionLog,
  ProjectPersona,
  ProjectProblemKeyInfo,
  ProjectTextImage,
  ProjectImageGalleryGrid,
  ProjectImageCarousel,
  ProjectAccessibilityAudit,
};

const { stops, leadBlocks } = buildStops(sections, headings);

const blockStops = stops.filter((s) => !s.headingId);
const mdStops = stops.filter((s) => s.headingId);
const mdDepth = headings.find((h) => h.slug === mdStops[0]?.headingId)?.depth ?? 2;
const lastIndex = stops.length - 1;

// The project's device as a small icon in every screenshot frame's title bar (see .screen-frame).
const icon = device ? spriteDataUri(device) : undefined;
const frameIconStyle = icon
  ? `--frame-icon: ${icon.uri}; --frame-icon-w: ${icon.width}px; --frame-icon-h: ${icon.height}px;`
  : undefined;
---

<main id="main-content" class="page cs" data-visit={slug} style={frameIconStyle}>
  <CaseStudyHero
    slug={slug}
    title={title}
    filename={filename}
    eyebrowLine={eyebrowLine}
    device={device}
    outcomeValue={outcomeValue}
    outcomeLabel={outcomeLabel}
    oneliner={oneliner}
    hero={hero}
    tldrBody={tldrBody}
    stopCount={stops.length}
    firstStopId={stops[0]?.id}
  />

  <div class="cs-layout">
    {stops.length > 0 && <RouteWindow stops={stops} device={device} />}

    <div class="cs-route proj-window-body">
      <div class="cs-line" aria-hidden="true"></div>

      {leadBlocks.map((section) => {
        const Component = blockComponents[section.component];
        return Component && <Component {...(section.props ?? {})} />;
      })}

      {blockStops.map((stop, i) => (
        <section id={stop.id} class="stop" aria-labelledby={`${stop.id}-h`}>
          <span class:list={['stop-dot', { first: i === 0, last: i === lastIndex }]} aria-hidden="true"></span>
          <p class="t-label stop-label">stop {i + 1}{i === lastIndex && ' · arrived'}</p>
          <h2 id={`${stop.id}-h`} class="stop-h">{stop.name}</h2>
          {stop.blocks.map(({ section, hideHeading, sub }) => {
            const Component = blockComponents[section.component];
            return Component && (
              <>
                {sub && <h3 id={sub.id} class="stop-sub">{sub.name}</h3>}
                <Component {...(section.props ?? {})} hideHeading={hideHeading} />
              </>
            );
          })}
        </section>
      ))}

      {hasBody && (
        <div
          class:list={['md-stops', `md-depth-${mdDepth}`, { 'md-arrives': mdStops.length > 0 }]}
          style={`counter-reset: stop ${blockStops.length};`}
        >
          <ProjectTextBlock>
            <slot />
          </ProjectTextBlock>
        </div>
      )}
    </div>
  </div>

  {next && (
    <section class="cs-next" aria-label="Next">
      <p class="t-label">next stop</p>
      <a href={next.href} class="cs-next-link">
        <span>{next.title} →</span>
        {next.device && <Device name={next.device} scale={4} />}
      </a>
    </section>
  )}
</main>

<ImageLightbox />

<script>
  import '../scripts/jargon-tips';
</script>

<style>
  .cs-layout {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-start;
  }

  .cs-route {
    flex: 999 1 560px;
    min-width: 0;
    position: relative;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* One measure for every run of text on the route, including inside cards. */
  .cs-route :global(:is(p, li, figcaption, dd)) { max-width: var(--measure); }

  /* The route: the home page's dotted leader rule, stood on end. */
  .cs-line {
    position: absolute;
    left: 20px;
    top: 8px;
    bottom: 40px;
    width: 0;
    border-left: 2px dotted var(--ink);
  }

  /* Blocks respond to the width a stop gives them, not the viewport. */
  .stop {
    position: relative;
    padding: 0 0 var(--space-6) 64px;
    container-type: inline-size;
  }

  /* Each stop is marked with a bevelled box from the window title bar.
     The first is tangerine ("look here"), the last is filled ink. */
  .stop-dot {
    position: absolute;
    left: 14px;
    top: 4px;
    width: 14px;
    height: 14px;
    background: var(--chrome-hi);
    border: 1px solid var(--ink);
    box-shadow: inset 1px 1px 0 var(--paper), inset -1px -1px 0 var(--bevel-lo);
  }

  .stop-dot.first { background: var(--tangerine); box-shadow: none; }
  .stop-dot.last { background: var(--ink); box-shadow: none; }

  .stop-label { margin-bottom: var(--space-1); }

  .stop-h {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
  }

  /* Sub-section of a chapter stop: no dot, no number. */
  .stop-sub {
    margin: var(--space-5) 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: var(--lh-tight);
  }

  .stop-sub:first-of-type { margin-top: var(--space-4); }

  /* Case study images keep their own colour. */

  /* Blocks inside a stop lose their own side padding; the stop column provides it. */
  .stop :global(.proj-section),
  .stop :global(.proj-gallery),
  .md-stops :global(.proj-section) { padding-left: 0; padding-right: 0; }

  /* Markdown body: its top heading level continues the stop numbering. */
  .md-stops { position: relative; padding-left: 64px; container-type: inline-size; }

  .md-stops :global(h1) { display: none; }

  .md-depth-2 :global(.proj-text-col > h2),
  .md-depth-3 :global(.proj-text-col > h3) {
    position: relative;
    counter-increment: stop;
    margin: 0 0 var(--space-3);
    padding-top: var(--space-5);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--ink);
  }

  .md-depth-2 :global(.proj-text-col > h2::before),
  .md-depth-3 :global(.proj-text-col > h3::before) {
    content: 'stop ' counter(stop);
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-machine);
    font-size: var(--machine-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--muted);
  }

  .md-depth-2 :global(.proj-text-col > h2::after),
  .md-depth-3 :global(.proj-text-col > h3::after) {
    content: '';
    position: absolute;
    left: -50px;
    top: 68px;
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    background: var(--chrome-hi);
    border: 1px solid var(--ink);
    box-shadow: inset 1px 1px 0 var(--paper), inset -1px -1px 0 var(--bevel-lo);
  }

  .md-arrives.md-depth-2 :global(.proj-text-col > h2:last-of-type::before),
  .md-arrives.md-depth-3 :global(.proj-text-col > h3:last-of-type::before) { content: 'stop ' counter(stop) ' · arrived'; }

  .md-arrives.md-depth-2 :global(.proj-text-col > h2:last-of-type::after),
  .md-arrives.md-depth-3 :global(.proj-text-col > h3:last-of-type::after) { background: var(--ink); box-shadow: none; }

  /* Forced colours drop the fills, so the markers use system colours instead:
     first is Highlight, last is solid text colour, the rest stay hollow. */
  @media (forced-colors: active) {
    .stop-dot,
    .md-depth-2 :global(.proj-text-col > h2::after),
    .md-depth-3 :global(.proj-text-col > h3::after) {
      forced-color-adjust: none;
      background: Canvas;
      border-color: CanvasText;
      box-shadow: none;
    }
    .stop-dot.first { background: Highlight; }
    .stop-dot.last,
    .md-arrives.md-depth-2 :global(.proj-text-col > h2:last-of-type::after),
    .md-arrives.md-depth-3 :global(.proj-text-col > h3:last-of-type::after) { background: CanvasText; }
  }

  .cs-next {
    border-top: 1px solid var(--ink);
    margin-top: 64px;
    padding: 36px 0 72px;
  }

  .cs-next .px { margin-bottom: 8px; }

  .cs-next-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-tight);
    color: var(--ink);
    text-decoration: none;
  }

  .cs-next-link:hover span { text-decoration: underline; color: var(--blue); }

  @media (max-width: 860px) {
    .cs-layout { gap: 40px; }
    .cs-line { left: 6px; }
    .stop { padding: 0 0 var(--space-5) 36px; }
    .stop-dot { left: 0; }
    .md-stops { padding-left: 36px; }
    .md-depth-2 :global(.proj-text-col > h2::after),
    .md-depth-3 :global(.proj-text-col > h3::after) { left: -36px; }
  }
</style>
