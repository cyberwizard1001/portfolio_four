---
import Device from './Device.astro';

const base = import.meta.env.BASE_URL;
---

<section class="signoff" aria-label="Sign-off">
  <!-- The radio is the Asteroids toy's device, so it doubles as the way in to /toys. -->
  <a href={`${base}toys`} class="signoff-toys">
    <Device name="radio" scale={4} />
    <span class="visually-hidden">Toys</span>
  </a>
  <p class="signoff-line">
    <span class="signoff-grey">Less friction,</span>
    more clarity,
    <span class="hl signoff-hl">better decisions.</span>
  </p>
</section>

<style>
  .signoff {
    padding: 8px 0 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  /* Echoes the hero headline: the page starts and ends in the same voice. */
  .signoff-line {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }

  /* --muted rather than --grey-mid: the lighter grey fails AA at the small end of the clamp. */
  .signoff-toys {
    display: inline-flex;
    padding: 6px;
    border: 1px solid transparent;
  }

  .signoff-toys:hover { border-color: var(--blue); }

  .signoff-toys:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

  .signoff-grey { color: var(--muted); }

  .signoff-hl { padding: 0 4px; }
</style>
