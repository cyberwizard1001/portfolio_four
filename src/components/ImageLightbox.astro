---
import WindowChrome from './WindowChrome.astro';
---

<dialog class="lightbox" aria-label="Image preview">
  <WindowChrome title="preview">
    <Fragment slot="actions">
      <button type="button" class="lightbox-tool lightbox-zoom" aria-label="Reset zoom">100%</button>
      <button type="button" class="lightbox-tool lightbox-close" aria-label="Close preview">×</button>
    </Fragment>
    <div class="lightbox-body">
      <div class="lightbox-frame">
        <div class="lightbox-stage"></div>
        <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous image" hidden>‹</button>
        <button type="button" class="lightbox-nav lightbox-next" aria-label="Next image" hidden>›</button>
      </div>
      <p class="lightbox-caption"></p>
      <span class="lightbox-status" aria-live="polite"></span>
    </div>
  </WindowChrome>
</dialog>

<style>
  .lightbox {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: min(92vw, 1400px);
    max-height: calc(100vh - 2rem);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--bg0) 85%, transparent);
  }

  .lightbox[open] {
    animation: lightbox-in 0.18s ease-out;
  }

  @keyframes lightbox-in {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: scale(1); }
  }

  .lightbox :global(.window) {
    border-color: var(--lime);
  }

  .lightbox-tool {
    cursor: pointer;
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
    color: var(--sub);
    background: transparent;
    border: 1px solid var(--border-hi);
    border-radius: 4px;
    padding: 2px 8px;
    margin-left: 8px;
  }

  .lightbox-tool:hover,
  .lightbox-tool:focus-visible {
    color: var(--lime);
    border-color: var(--lime);
  }

  .lightbox-zoom {
    min-width: 4.5ch;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-body {
    background: var(--bg1);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    gap: 0.75rem;
  }

  .lightbox-frame {
    position: relative;
    max-width: 100%;
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-in;
  }

  .lightbox-stage[data-zoomed] { cursor: grab; }
  .lightbox-stage[data-dragging] { cursor: grabbing; }

  .lightbox-stage :global(.lightbox-img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100vh - 10rem);
    object-fit: contain;
    transform-origin: 0 0;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox-stage :global(.lightbox-img.is-animating) {
    transition: transform 0.2s ease-out;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    border: 1px solid var(--border-hi);
    background: var(--bg1);
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .lightbox-nav[hidden] { display: none; }

  .lightbox-nav:hover {
    border-color: var(--lime);
    color: var(--lime);
  }

  .lightbox-nav:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }

  .lightbox-prev { left: 0.625rem; }
  .lightbox-next { right: 0.625rem; }

  .lightbox-caption {
    margin: 0;
    font-family: var(--font-text);
    font-size: 13px;
    color: var(--dim);
    text-align: center;
  }

  .lightbox-caption:empty { display: none; }

  .lightbox-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] { animation: none; }
    .lightbox-stage :global(.lightbox-img.is-animating) { transition: none; }
  }

  :global(html:has(dialog.lightbox[open])) { overflow: hidden; }

  :global(img[data-lightbox]) { cursor: zoom-in; }

  @media (max-width: 480px) {
    .lightbox-body { padding: 0.5rem; }
  }
</style>

<script>
  (function () {
    const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    // The route column, plus any block outside it that opts in (the hero viewer).
    const roots = [...document.querySelectorAll<HTMLElement>('.proj-window-body, [data-lightbox-root]')];
    if (!dialog || !roots.length) return;

    const stage = dialog.querySelector<HTMLElement>('.lightbox-stage')!;
    // Created here rather than in the HTML: an <img> needs a src, and the preview has none until opened.
    const img = document.createElement('img');
    img.className = 'lightbox-img';
    img.alt = '';
    img.draggable = false;
    stage.append(img);
    const caption = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
    const status = dialog.querySelector<HTMLElement>('.lightbox-status')!;
    const title = dialog.querySelector<HTMLElement>('.win-title')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-close')!;
    const zoomBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-zoom')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-prev')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-next')!;

    const MIN_SCALE = 1;
    const MAX_SCALE = 4;
    const DOUBLE_TAP_SCALE = 2.5;
    const SWIPE_THRESHOLD = 40;

    let trigger: HTMLElement | null = null;
    let group: HTMLImageElement[] = [];
    let index = 0;

    const eligible = roots.flatMap((root) => [...root.querySelectorAll<HTMLImageElement>('img:not(.proj-persona img)')]);
    eligible.forEach((el) => {
      el.dataset.lightbox = '';
      // Images inside a full-size link are reached through the link. Carousel
      // slides are too: only the active slide's link is in the tab order.
      if (el.closest('.proj-img-link, .proj-carousel')) return;
      el.tabIndex = 0;
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', `Enlarge image${el.alt ? `: ${el.alt}` : ''}`);
    });

    // ── Zoom + pan ──
    // transform-origin is 0 0, so a stage point p maps to image point (p - t) / scale.
    let scale = 1;
    let tx = 0;
    let ty = 0;

    const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

    const apply = (animate = false) => {
      const w = img.offsetWidth;
      const h = img.offsetHeight;
      if (scale <= MIN_SCALE) {
        scale = MIN_SCALE;
        tx = 0;
        ty = 0;
      } else {
        tx = clamp(tx, w - w * scale, 0);
        ty = clamp(ty, h - h * scale, 0);
      }
      img.classList.toggle('is-animating', animate);
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      stage.toggleAttribute('data-zoomed', scale > MIN_SCALE);
      zoomBtn.textContent = `${Math.round(scale * 100)}%`;
    };

    const zoomAt = (next: number, px: number, py: number, animate = false) => {
      const target = clamp(next, MIN_SCALE, MAX_SCALE);
      tx = px - (px - tx) * (target / scale);
      ty = py - (py - ty) * (target / scale);
      scale = target;
      apply(animate);
    };

    const zoomCenter = (next: number) => zoomAt(next, img.offsetWidth / 2, img.offsetHeight / 2, true);

    const resetZoom = (animate = false) => {
      scale = MIN_SCALE;
      apply(animate);
    };

    // Point in the image's untransformed layout box (the stage may be wider
    // than the image when the image is height-limited).
    const stagePoint = (x: number, y: number) => {
      const rect = stage.getBoundingClientRect();
      return { x: x - rect.left - img.offsetLeft, y: y - rect.top - img.offsetTop };
    };

    const toggleZoomAt = (x: number, y: number) => {
      const p = stagePoint(x, y);
      if (scale > MIN_SCALE) resetZoom(true);
      else zoomAt(DOUBLE_TAP_SCALE, p.x, p.y, true);
    };

    const pointers = new Map<number, { x: number; y: number }>();
    let panStart = { x: 0, y: 0, tx: 0, ty: 0 };
    let pinchStart = { dist: 0, scale: 1 };
    let lastMid = { x: 0, y: 0 };
    let pinched = false;
    let lastTap = { time: 0, x: 0, y: 0 };

    const pinchInfo = () => {
      const [a, b] = [...pointers.values()];
      return {
        dist: Math.hypot(b.x - a.x, b.y - a.y),
        mid: stagePoint((a.x + b.x) / 2, (a.y + b.y) / 2),
      };
    };

    const startPan = (x: number, y: number) => {
      panStart = { x, y, tx, ty };
    };

    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      stage.setPointerCapture(event.pointerId);
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 2) {
        pinched = true;
        const { dist, mid } = pinchInfo();
        pinchStart = { dist, scale };
        lastMid = mid;
      } else if (pointers.size === 1) {
        startPan(event.clientX, event.clientY);
        if (scale > MIN_SCALE) stage.toggleAttribute('data-dragging', true);
      }
    });

    stage.addEventListener('pointermove', (event) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pointers.size === 2) {
        const { dist, mid } = pinchInfo();
        tx += mid.x - lastMid.x;
        ty += mid.y - lastMid.y;
        lastMid = mid;
        zoomAt(pinchStart.scale * (dist / pinchStart.dist), mid.x, mid.y);
      } else if (pointers.size === 1 && scale > MIN_SCALE) {
        tx = panStart.tx + (event.clientX - panStart.x);
        ty = panStart.ty + (event.clientY - panStart.y);
        apply();
      }
    });

    const endPointer = (event: PointerEvent) => {
      if (!pointers.has(event.pointerId)) return;
      pointers.delete(event.pointerId);

      if (pointers.size === 1) {
        // Pinch ended with one finger still down: continue as a pan from here.
        const [rest] = [...pointers.values()];
        startPan(rest.x, rest.y);
        return;
      }
      if (pointers.size > 0) return;

      stage.removeAttribute('data-dragging');
      const dx = event.clientX - panStart.x;
      const dy = event.clientY - panStart.y;
      const wasPinch = pinched;
      pinched = false;
      if (wasPinch || event.type === 'pointercancel') return;

      if (scale === MIN_SCALE && Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
        step(dx < 0 ? 1 : -1);
        return;
      }

      // Mouse double-clicks go through dblclick; detect double-tap for touch/pen.
      if (event.pointerType !== 'mouse' && Math.hypot(dx, dy) < 10) {
        const now = event.timeStamp;
        const near = Math.hypot(event.clientX - lastTap.x, event.clientY - lastTap.y) < 30;
        if (now - lastTap.time < 300 && near) {
          toggleZoomAt(event.clientX, event.clientY);
          lastTap = { time: 0, x: 0, y: 0 };
        } else {
          lastTap = { time: now, x: event.clientX, y: event.clientY };
        }
      }
    };

    stage.addEventListener('pointerup', endPointer);
    stage.addEventListener('pointercancel', endPointer);

    stage.addEventListener('dblclick', (event) => toggleZoomAt(event.clientX, event.clientY));

    // Trackpad pinch arrives as ctrl+wheel; a plain wheel pans once zoomed in.
    stage.addEventListener('wheel', (event) => {
      if (event.ctrlKey) {
        event.preventDefault();
        const p = stagePoint(event.clientX, event.clientY);
        zoomAt(scale * Math.exp(-event.deltaY * 0.01), p.x, p.y);
      } else if (scale > MIN_SCALE) {
        event.preventDefault();
        tx -= event.deltaX;
        ty -= event.deltaY;
        apply();
      }
    }, { passive: false });

    zoomBtn.addEventListener('click', () => resetZoom(true));

    // ── Navigation ──
    const filename = (src: string) => decodeURIComponent(src.split('/').pop()?.split('?')[0] ?? 'preview');

    const preload = (i: number) => {
      const source = group[((i % group.length) + group.length) % group.length];
      if (source) new Image().src = source.currentSrc || source.src;
    };

    const show = (i: number) => {
      index = ((i % group.length) + group.length) % group.length;
      const source = group[index];
      const src = source.currentSrc || source.src;
      resetZoom();
      img.src = src;
      img.alt = source.alt;
      caption.textContent = source.alt;

      const multiple = group.length > 1;
      title.textContent = filename(src);
      if (multiple) {
        const counter = document.createElement('span');
        counter.className = 'active-title';
        counter.textContent = ` ${index + 1}/${group.length}`;
        title.append(counter);
        status.textContent = `Image ${index + 1} of ${group.length}`;
        preload(index + 1);
        preload(index - 1);
      } else {
        status.textContent = '';
      }
      prevBtn.hidden = !multiple;
      nextBtn.hidden = !multiple;
    };

    const step = (dir: number) => {
      if (group.length > 1) show(index + dir);
    };

    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    const open = (source: HTMLImageElement, returnTo: HTMLElement, root: HTMLElement) => {
      // A [data-lightbox-group] previews only what it is showing, not the shots it has hidden.
      const own = source.closest<HTMLElement>('[data-lightbox-group]');
      const section = own ?? source.closest('section') ?? root;
      group = [...section.querySelectorAll<HTMLImageElement>('img[data-lightbox]')].filter(
        (el) => !own || !el.closest('[data-off]')
      );
      trigger = returnTo;
      dialog.showModal();
      show(Math.max(0, group.indexOf(source)));
      closeBtn.focus();
    };

    roots.forEach((root) => {
    root.addEventListener('click', (event) => {
      const el = event.target as HTMLElement;
      const link = el.closest<HTMLAnchorElement>('.proj-img-link');
      const target = link
        ? link.querySelector<HTMLImageElement>('img[data-lightbox]')
        : el.closest<HTMLImageElement>('img[data-lightbox]');
      if (!target) return;
      // The link is the no-JS fallback to the full-size file; with JS the preview opens instead.
      event.preventDefault();
      open(target, link ?? target.closest<HTMLElement>('.proj-carousel') ?? target, root);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const target = event.target as HTMLElement;
      if (target.matches('img[data-lightbox]')) {
        event.preventDefault();
        open(target as HTMLImageElement, target, root);
      } else if (target.matches('.proj-carousel')) {
        const active = target.querySelector<HTMLImageElement>('.proj-carousel-slide[data-active] img');
        if (!active) return;
        event.preventDefault();
        open(active, target, root);
      }
    });
    });

    const PAN_STEP = 60;

    dialog.addEventListener('keydown', (event) => {
      const zoomed = scale > MIN_SCALE;
      switch (event.key) {
        case 'ArrowLeft':
          event.preventDefault();
          if (zoomed) { tx += PAN_STEP; apply(true); } else step(-1);
          break;
        case 'ArrowRight':
          event.preventDefault();
          if (zoomed) { tx -= PAN_STEP; apply(true); } else step(1);
          break;
        case 'ArrowUp':
          if (!zoomed) return;
          event.preventDefault();
          ty += PAN_STEP;
          apply(true);
          break;
        case 'ArrowDown':
          if (!zoomed) return;
          event.preventDefault();
          ty -= PAN_STEP;
          apply(true);
          break;
        case '+':
        case '=':
          event.preventDefault();
          zoomCenter(scale * 1.5);
          break;
        case '-':
          event.preventDefault();
          zoomCenter(scale / 1.5);
          break;
        case '0':
          event.preventDefault();
          resetZoom(true);
          break;
      }
    });

    closeBtn.addEventListener('click', () => dialog.close());

    // Clicks on the dialog element itself (not its children) land on the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      trigger?.focus();
      trigger = null;
      group = [];
      pointers.clear();
      resetZoom();
      img.removeAttribute('src');
    });
  })();
</script>
