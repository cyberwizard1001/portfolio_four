---
import WindowChrome from './WindowChrome.astro';
import Device from './Device.astro';

const base = import.meta.env.BASE_URL;

const links = [
  {
    title: '~/ai — how_i_use_it',
    teaser: 'How I use Claude at work, and how I ensure that the human makes decisions.',
    href: `${base}ai`,
    label: 'How I use AI',
    isNew: true,
    diff: { remove: 'an agent acting on its own', add: 'a tool held in my hand' },
  },
  {
    title: '~/about — whoami',
    teaser: 'More about me and a lot less about insurance.',
    href: `${base}about`,
    label: 'About me',
  },
  {
    title: '~/portfolio — v7',
    teaser: 'I redesigned this site seven times and it taught me a few things along the way.',
    href: `${base}projects/portfolio-meta/`,
    label: 'Read the case study',
  },
];
---

<section class="more-about" id="about" aria-labelledby="more-about-heading">
  <h2 id="more-about-heading" class="visually-hidden">More about me</h2>
  <Device name="flip" scale={5} class="spr gut" style="right: -100px; top: -30px;" />
  {links.map((item) => (
    <WindowChrome title={item.title} isNew={item.isNew}>
      <div class="ma-body">
        <p>{item.teaser}</p>
        {item.diff && (
          <p class="ma-diff">
            <span class="ma-diff-remove">- {item.diff.remove}</span>
            <span class="ma-diff-add">+ {item.diff.add}</span>
          </p>
        )}
        <a href={item.href} class="mbtn def ma-btn">
          <kbd class="keycap" aria-hidden="true">↵</kbd>
          <span>{item.label}</span>
        </a>
      </div>
    </WindowChrome>
  ))}
</section>

<style>
  .more-about {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    padding-bottom: 96px;
  }

  .ma-body {
    flex: 1;
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ma-diff {
    font-family: var(--font-machine);
    font-size: var(--machine-chip);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
  }

  .ma-diff-remove { color: var(--muted); text-decoration: line-through var(--blue); }
  .ma-diff-add { color: var(--blue); }

  .ma-btn {
    margin-top: auto;
    align-self: flex-start;
  }

  @media (max-width: 1024px) {
    .more-about { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 860px) {
    .more-about { grid-template-columns: 1fr; padding-bottom: 72px; }
    .ma-body { padding: 22px 20px; }
  }
</style>
